<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="780.0" prefWidth="1001.0"
            style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;"
            vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1">

    <AnchorPane maxHeight="750" maxWidth="1014" minHeight="650" minWidth="1000"
                style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

        <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
        </padding>

        <!-- ===== CABEÇALHO ===== -->
        <VBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER_LEFT" maxHeight="70" spacing="12.0"
                  style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                <padding>
                    <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                </padding>

                <StackPane>
                    <Circle fill="#4F46E5" radius="18.0" />
                    <Label style="-fx-font-size: 14px;" text="📦" />
                </StackPane>

                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1E293B;"
                           text="Detalhes da Movimentação" wrapText="true" />
                    <Label fx:id="subtitleLabel" style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;"
                           text="Visualização completa" wrapText="true" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Button fx:id="btn_imprimir" text="🖨️" styleClass="btn-icon-gray">
                        <tooltip><Tooltip text="Imprimir detalhes" /></tooltip>
                    </Button>
                    <Button fx:id="btn_exportar" text="📤" styleClass="btn-icon-green">
                        <tooltip><Tooltip text="Exportar dados" /></tooltip>
                    </Button>
                    <Button fx:id="btn_voltar" text="✕" styleClass="btn-icon-danger">
                        <tooltip><Tooltip text="Fechar (ESC)" /></tooltip>
                    </Button>
                </HBox>
            </HBox>
        </VBox>

        <!-- ===== CONTEÚDO PRINCIPAL ===== -->
        <VBox spacing="12.0" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="12.0"
              AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="75.0">

            <!-- ===== CARDS DE RESUMO ===== -->
            <HBox alignment="TOP_CENTER" spacing="12.0">

                <VBox maxWidth="220" minWidth="180" spacing="6.0" styleClass="detail-card-compact">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="TIPO" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <StackPane>
                            <Circle fx:id="tipoCircle" radius="10.0" />
                            <Label fx:id="tipoIcon" style="-fx-font-size: 11px;" />
                        </StackPane>
                        <Label fx:id="tipoLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" wrapText="true" />
                    </HBox>
                </VBox>

                <VBox maxWidth="220" minWidth="180" spacing="6.0" styleClass="detail-card-compact">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="QUANTIDADE" />
                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                        <Label fx:id="quantidadeLabel" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #1E293B;" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-padding: 4 0 0 0;" text="unid" />
                    </HBox>
                </VBox>

                <VBox maxWidth="250" minWidth="200" spacing="6.0" styleClass="detail-card-compact">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="STATUS" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <StackPane><Circle fx:id="statusCircle" radius="8.0" /></StackPane>
                        <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" wrapText="true" />
                    </HBox>
                    <Label fx:id="statusDetailLabel" style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" wrapText="true" />
                </VBox>

                <VBox maxWidth="300" minWidth="240" spacing="6.0" styleClass="detail-card-compact">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-font-weight: bold;" text="RASTREABILIDADE" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="ID:" />
                        <Label fx:id="idLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" text="Criado:" />
                        <Label fx:id="createdAtLabel" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                    </HBox>
                    <Label fx:id="rastreabilidadeLabel" style="-fx-font-size: 10px; -fx-text-fill: #94A3B8; -fx-wrap-text: true;" />
                </VBox>
            </HBox>

            <!-- ===== LAYOUT PRINCIPAL ===== -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                <!-- ===== COLUNA ESQUERDA ===== -->
                <VBox minWidth="550" spacing="10.0" HBox.hgrow="ALWAYS">

                    <!-- Card Informações do Produto -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#4F46E5" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="INFORMAÇÕES DO PRODUTO" />
                        </HBox>

                        <GridPane hgap="10.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="100" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Produto:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="produtoLabel" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="codigoProdutoLabel" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-text-fill: #1E293B;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Categoria:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="categoriaLabel" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        </GridPane>
                    </VBox>

                    <!-- Card Detalhes da Movimentação -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#EF4444" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="DETALHES DA MOVIMENTAÇÃO" />
                        </HBox>

                        <GridPane hgap="10.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="100" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="dataMovimentacaoLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #1E293B;" />
                                <Label fx:id="diasAtrasLabel" style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Lote:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="loteLabel" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-text-fill: #1E293B;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Localização:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label fx:id="localizacaoLabel" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" wrapText="true" />
                                <Button fx:id="btn_mapa" text="🗺️" styleClass="btn-icon" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Validade:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                <Label fx:id="validadeLabel" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" wrapText="true" />
                                <Label fx:id="validadeStatusLabel" styleClass="status-badge" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Fim Licença:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <Label fx:id="fimLicencaLabel" style="-fx-font-size: 12px; -fx-text-fill: #1E293B;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        </GridPane>
                    </VBox>

                    <!-- Card Observações -->
                    <VBox spacing="10.0" styleClass="detail-card" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#F59E0B" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="OBSERVAÇÕES" />
                        </HBox>

                        <VBox spacing="6.0">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Motivo:" />
                            <TextArea fx:id="motivoTextArea" editable="false" prefHeight="60" styleClass="detail-textarea" wrapText="true" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 11px;" text="Detalhes:" />
                            <TextArea fx:id="observacoesTextArea" editable="false" prefHeight="80" styleClass="detail-textarea" wrapText="true" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ===== COLUNA DIREITA ===== -->
                <VBox maxWidth="380" minWidth="300" spacing="10.0">

                    <!-- Card Responsável -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#22C55E" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="RESPONSÁVEL" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane>
                                <Circle fill="#F1F5F9" radius="20.0" />
                                <Label fx:id="usuarioInicial" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
                            </StackPane>

                            <VBox spacing="2.0">
                                <Label fx:id="usuarioNomeLabel" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" wrapText="true" />
                                <Label fx:id="usuarioDepartamentoLabel" style="-fx-font-size: 10px; -fx-text-fill: #94A3B8;" wrapText="true" />
                                <Label fx:id="usuarioEmailLabel" style="-fx-font-size: 9px; -fx-text-fill: #4F46E5;" wrapText="true" />
                            </VBox>
                        </HBox>

                        <Button fx:id="btn_contatar" text="✉️ Mensagem" styleClass="btn-primary" />
                    </VBox>

                    <!-- Card Timeline -->
                    <VBox spacing="10.0" styleClass="detail-card" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#8B5CF6" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="LINHA DO TEMPO" />
                        </HBox>

                        <VBox fx:id="timelineContainer" spacing="6.0" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <!-- Card Ações Rápidas -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#EF4444" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="AÇÕES" />
                        </HBox>

                        <VBox spacing="6.0">
                            <Button fx:id="btn_editar" text="✏️ Editar" styleClass="btn-action-warning" />
                            <Button fx:id="btn_duplicar" text="📋 Duplicar" styleClass="btn-action-gray" />
                            <Button fx:id="btn_excluir" text="🗑️ Excluir" styleClass="btn-action-danger" />
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- ===== RODAPÉ ===== -->
        <HBox alignment="CENTER" spacing="4.0" AnchorPane.bottomAnchor="4.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Label style="-fx-text-fill: #94A3B8; -fx-font-size: 9px;" text="Sistema de Gestão • " />
            <Label fx:id="lastUpdatedLabel" style="-fx-text-fill: #94A3B8; -fx-font-size: 9px; -fx-font-weight: bold;" text="Atualizado: --" />
        </HBox>
    </AnchorPane>
</ScrollPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1">

    <VBox spacing="15" style="-fx-padding: 20;"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- Cabeçalho -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"
                   text="Movimentações de Estoque" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_novaMovimentacao" text="➕ Nova Movimentação" styleClass="btn-primary" />
            <Button fx:id="btn_relatorio" text="📊 Relatório" styleClass="btn-secondary" />
            <Button fx:id="btn_exportar" text="📤 Exportar" styleClass="btn-secondary" />
        </HBox>

        <!-- Filtros -->
        <VBox fx:id="filtrosContainer" spacing="10" styleClass="list-card">
            <padding><Insets bottom="15" left="20" right="20" top="15" /></padding>
            <Label text="Filtros de Pesquisa" styleClass="list-card-header" />

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="200" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="200" />
                </columnConstraints>

                <Label text="Período:" styleClass="filter-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <DatePicker fx:id="dataInicio" promptText="Data Início" />
                    <Label text="até" styleClass="filter-separator" />
                    <DatePicker fx:id="dataFim" promptText="Data Fim" />
                </HBox>

                <Label text="Tipo Movimentação:" styleClass="filter-label" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="filtroTipo" promptText="Todos os tipos" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <Label text="Produto:" styleClass="filter-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="filtroProduto" promptText="Selecione o produto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Lote:" styleClass="filter-label" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="filtroLote" promptText="Número do lote" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            </GridPane>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btn_limparFiltros" text="Limpar Filtros" styleClass="btn-secondary" />
                <Button fx:id="btn_aplicarFiltros" text="Aplicar Filtros" styleClass="btn-primary" />
            </HBox>
        </VBox>

        <!-- Gráfico -->
        <VBox fx:id="graficoContainer" managed="false" spacing="10" visible="false">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Resumo de Movimentações por Tipo" />
            <PieChart fx:id="movimentacoesChart" prefHeight="200" styleClass="pie-chart" />
        </VBox>

        <!-- Tabela -->
        <TableView fx:id="movimentacoesTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn prefWidth="100" text="Data">
                    <cellValueFactory><PropertyValueFactory property="dataMovimentacao" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="150" text="Produto">
                    <cellValueFactory><PropertyValueFactory property="nomeProduto" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="100" text="SKU">
                    <cellValueFactory><PropertyValueFactory property="skuProduto" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="90" text="Tipo">
                    <cellValueFactory><PropertyValueFactory property="tipoMovimentacao" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="80" text="Qtd">
                    <cellValueFactory><PropertyValueFactory property="quantidade" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="100" text="Lote">
                    <cellValueFactory><PropertyValueFactory property="lote" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="100" text="Validade">
                    <cellValueFactory><PropertyValueFactory property="dataValidade" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="120" text="Localização">
                    <cellValueFactory><PropertyValueFactory property="localizacao" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="120" text="Responsável">
                    <cellValueFactory><PropertyValueFactory property="nomeUsuario" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="150" text="Motivo">
                    <cellValueFactory><PropertyValueFactory property="motivo" /></cellValueFactory>
                </TableColumn>
                <TableColumn prefWidth="100" text="Ações">
                    <cellValueFactory><PropertyValueFactory property="acoes" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Rodapé com Estatísticas -->
        <HBox fx:id="estatisticasContainer" alignment="CENTER" spacing="30" styleClass="stats-bar">
            <VBox alignment="CENTER" spacing="5">
                <Label text="Total Entradas" styleClass="stat-label" />
                <Label fx:id="totalEntradasLabel" text="0" styleClass="stat-value-success" />
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Total Saídas" styleClass="stat-label" />
                <Label fx:id="totalSaidasLabel" text="0" styleClass="stat-value-danger" />
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Saldo" styleClass="stat-label" />
                <Label fx:id="saldoLabel" text="0" styleClass="stat-value-primary" />
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Registros" styleClass="stat-label" />
                <Label fx:id="totalRegistrosLabel" text="0" styleClass="stat-value" />
            </VBox>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Período" styleClass="stat-label" />
                <Label fx:id="periodoLabel" text="Últimos 30 dias" styleClass="stat-value" />
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="700.0" prefWidth="800.0"
            styleClass="form-root">

    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20.0">

            <!-- Cabeçalho -->
            <Label fx:id="tituloLabel" text="Nova Movimentação de Estoque" styleClass="form-title">
                <padding><Insets bottom="10.0" left="20.0" right="20.0" top="20.0" /></padding>
            </Label>

            <!-- Informações do Produto -->
            <VBox spacing="10.0" styleClass="form-product-info">
                <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                <Label text="Produto Selecionado" styleClass="form-section-title-blue" />
                <Label fx:id="produtoInfoLabel" text="Nenhum produto selecionado" styleClass="form-product-text" />
                <Label fx:id="saldoAtualLabel" text="Saldo atual: -" styleClass="form-saldo-label" />
                <Button fx:id="btn_selecionarProduto" text="Selecionar Produto" styleClass="btn-primary" />
            </VBox>

            <!-- Formulário Principal -->
            <GridPane hgap="15.0" vgap="15.0" styleClass="form-grid">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="180.0" prefWidth="180.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" prefWidth="250.0" />
                </columnConstraints>

                <Label text="Tipo de Movimentação *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="tipoMovimentacao" promptText="Selecione o tipo" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Quantidade *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <HBox spacing="10.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="quantidadeField" promptText="Quantidade" HBox.hgrow="ALWAYS" />
                    <Label text="un" styleClass="form-unit-label" />
                </HBox>

                <Label text="Número do Lote" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="loteField" promptText="Número do lote (opcional)" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Data da Movimentação *" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <DatePicker fx:id="dataMovimentacao" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Data de Validade" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <DatePicker fx:id="dataValidade" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <Label text="Data Fim Licença" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <DatePicker fx:id="dataFimLicenca" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <Label text="Localização" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <TextField fx:id="localizacaoField" promptText="Local onde o item será armazenado" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                <Label text="Motivo *" styleClass="form-label" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <TextField fx:id="motivoField" promptText="Motivo da movimentação" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                <Label text="Observações" styleClass="form-label" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                <TextArea fx:id="observacoesField" promptText="Observações adicionais" wrapText="true" prefRowCount="3" GridPane.rowIndex="8" GridPane.columnIndex="1" />
            </GridPane>

            <!-- Impacto no Saldo -->
            <VBox spacing="10.0" styleClass="form-impacto-box">
                <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                <Label text="Impacto no Saldo" styleClass="form-section-title-warning" />
                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <VBox spacing="5.0">
                        <Label text="Saldo Atual" styleClass="impact-label" />
                        <Label fx:id="saldoAtualDisplay" text="0" styleClass="impact-value" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Movimentação" styleClass="impact-label" />
                        <Label fx:id="movimentacaoDisplay" text="+0" styleClass="impact-value-movement" />
                    </VBox>
                    <VBox spacing="5.0">
                        <Label text="Novo Saldo" styleClass="impact-label" />
                        <Label fx:id="novoSaldoDisplay" text="0" styleClass="impact-value-new" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- Mensagem de Erro -->
            <Label fx:id="mensagemErroLabel" styleClass="form-message-error"
                   visible="false" managed="false" maxWidth="1.7976931348623157E308">
                <padding><Insets left="20.0" right="20.0" /></padding>
            </Label>

            <!-- Botões de Ação -->
            <HBox spacing="15.0" alignment="CENTER_RIGHT">
                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>
                <Button fx:id="btn_cancelar" text="Cancelar" styleClass="btn-secondary" />
                <Button fx:id="btn_salvar" text="Registrar Movimentação" styleClass="btn-success" />
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
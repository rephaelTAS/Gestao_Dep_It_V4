<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="720.0"
            maxWidth="1080.0"
            minHeight="600.0"
            minWidth="900.0"
            prefHeight="680.0"
            prefWidth="1000.0"
            styleClass="app-root, login-root"
            xmlns="http://javafx.com/javafx/21.0"
            xmlns:fx="http://javafx.com/fxml/1">

    <HBox prefHeight="680.0"
          prefWidth="1000.0"
          spacing="0.0"
          styleClass="login-container"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <!-- ================================================= -->
        <!-- SIDEBAR                                            -->
        <!-- ================================================= -->

        <StackPane minWidth="300.0"
                   maxWidth="360.0"
                   prefWidth="320.0"
                   HBox.hgrow="NEVER"
                   styleClass="login-sidebar">

            <VBox alignment="CENTER"
                  spacing="0.0"
                  minWidth="300.0"
                  maxWidth="360.0">

                <padding>
                    <Insets top="56.0"
                            bottom="36.0"
                            left="32.0"
                            right="32.0"/>
                </padding>

                <!-- Logótipo -->
                <StackPane styleClass="login-logo-wrap">
                    <Label styleClass="login-logo-fallback" text="P"/>
                </StackPane>

                <Region minHeight="28.0" prefHeight="28.0"/>

                <!-- Identidade -->
                <VBox alignment="CENTER"
                      spacing="8.0"
                      maxWidth="256.0">

                    <Label styleClass="login-sidebar-title"
                           text="Packt Inventário"
                           textAlignment="CENTER"
                           wrapText="true"/>

                    <Label styleClass="login-sidebar-subtitle"
                           text="Gestão Inteligente"
                           textAlignment="CENTER"
                           wrapText="true"/>

                </VBox>

                <Region minHeight="40.0" prefHeight="40.0"/>

                <!-- Funcionalidades -->
                <VBox alignment="TOP_LEFT"
                      spacing="12.0"
                      maxWidth="256.0"
                      fillWidth="true">

                    <HBox alignment="CENTER_LEFT"
                          spacing="12.0"
                          styleClass="ds-chip">
                        <Label styleClass="login-feature-check" text="✓"/>
                        <Label styleClass="login-feature-text"
                               text="Controle em tempo real"
                               wrapText="true"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12.0"
                          styleClass="ds-chip">
                        <Label styleClass="login-feature-check" text="✓"/>
                        <Label styleClass="login-feature-text"
                               text="Relatórios avançados"
                               wrapText="true"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT"
                          spacing="12.0"
                          styleClass="ds-chip">
                        <Label styleClass="login-feature-check" text="✓"/>
                        <Label styleClass="login-feature-text"
                               text="Interface moderna"
                               wrapText="true"/>
                    </HBox>

                </VBox>

                <Region VBox.vgrow="ALWAYS" maxHeight="Infinity"/>

                <Label styleClass="ds-caption, login-version-badge"
                       text="v2.4.1"/>

            </VBox>
        </StackPane>

        <!-- ================================================= -->
        <!-- ÁREA PRINCIPAL                                     -->
        <!-- ================================================= -->

        <StackPane minWidth="600.0"
                   maxWidth="Infinity"
                   prefHeight="680.0"
                   HBox.hgrow="ALWAYS"
                   alignment="CENTER"
                   styleClass="login-form-area">

            <!-- Cartão de login -->
            <VBox alignment="TOP_CENTER"
                  spacing="0.0"
                  maxWidth="500.0"
                  maxHeight="580.0"
                  styleClass="ds-card, login-form-card">

                <!-- Cabeçalho do formulário -->
                <VBox alignment="CENTER" spacing="10.0">

                    <Label styleClass="login-form-title"
                           text="Bem-vindo de volta"
                           textAlignment="CENTER"
                           wrapText="true"
                           maxWidth="380.0"/>

                    <Label styleClass="login-form-subtitle"
                           text="Entre para gerenciar seu inventário"
                           textAlignment="CENTER"
                           wrapText="true"
                           maxWidth="380.0"/>

                </VBox>

                <Region minHeight="38.0" prefHeight="38.0"/>

                <!-- Campos -->
                <VBox alignment="TOP_CENTER"
                      spacing="24.0"
                      prefWidth="Infinity"
                      fillWidth="true">

                    <!-- Utilizador -->
                    <VBox styleClass="ds-field"
                          alignment="TOP_LEFT"
                          prefWidth="Infinity"
                          fillWidth="true">

                        <Label styleClass="ds-field-label" text="Usuário"/>

                        <TextField fx:id="usuario"
                                   promptText="nome@empresa.com"
                                   styleClass="ds-input"
                                   prefWidth="Infinity"/>

                        <Label fx:id="erroUsuario"
                               styleClass="ds-field-error"
                               text=""
                               managed="false"
                               visible="false"/>

                    </VBox>

                    <!-- Palavra-passe -->
                    <VBox styleClass="ds-field"
                          alignment="TOP_LEFT"
                          prefWidth="Infinity"
                          fillWidth="true">

                        <Label styleClass="ds-field-label" text="Senha"/>

                        <PasswordField fx:id="senha"
                                       promptText="Sua senha"
                                       styleClass="ds-input"
                                       prefWidth="Infinity"/>

                        <Label fx:id="erroSenha"
                               styleClass="ds-field-error"
                               text=""
                               managed="false"
                               visible="false"/>

                        <HBox alignment="CENTER_RIGHT" prefWidth="Infinity">
                            <Button styleClass="ds-button, ds-button--link"
                                    text="Esqueceu a senha?"
                                    focusTraversable="true"/>
                        </HBox>

                    </VBox>

                    <!-- Manter sessão -->
                    <CheckBox fx:id="cb_lembrar"
                              styleClass="ds-checkbox"
                              text="Manter conectado"/>

                </VBox>

                <Region VBox.vgrow="ALWAYS" maxHeight="Infinity"/>

                <!-- Ações -->
                <VBox alignment="CENTER"
                      spacing="14.0"
                      maxWidth="Infinity"
                      fillWidth="true">

                    <Button fx:id="btn_login"
                            text="Entrar no Sistema"
                            maxWidth="Infinity"
                            defaultButton="true"
                            styleClass="ds-button, ds-button--primary, ds-button--comfortable"/>

                </VBox>

                <Region minHeight="30.0" prefHeight="30.0"/>

                <!-- Rodapé -->
                <VBox alignment="CENTER" spacing="4.0">

                    <Label styleClass="ds-caption, login-footer-text"
                           text="Packt Inventário v2.4.1"/>

                    <Label styleClass="ds-caption, login-footer-text"
                           text="© 2024 Todos os direitos reservados"/>

                </VBox>

            </VBox>
        </StackPane>
    </HBox>
</AnchorPane>
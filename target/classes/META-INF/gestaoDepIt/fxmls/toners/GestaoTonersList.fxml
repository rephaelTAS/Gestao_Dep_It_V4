<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="800.0" prefWidth="1400.0"
            styleClass="toner-list-root">

    <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Gestão de Toners em Equipamentos" styleClass="list-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_novaInstalacao" text="+ Nova Instalação" styleClass="btn-primary" />
        </HBox>

        <!-- ===== FILTROS ===== -->
        <VBox spacing="10.0" styleClass="list-card">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>

            <Label text="Filtros de Gestão de Toners" styleClass="list-card-header" />

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                </columnConstraints>

                <Label text="Equipamento:" styleClass="filter-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <ComboBox fx:id="filtroEquipamento" promptText="Todos equipamentos" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Toner:" styleClass="filter-label" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <ComboBox fx:id="filtroToner" promptText="Todos toners" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Percentagem:" styleClass="filter-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <HBox spacing="5.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <TextField fx:id="filtroPercentagemMin" promptText="Mín" prefWidth="60" />
                    <Label text="a" styleClass="filter-separator" />
                    <TextField fx:id="filtroPercentagemMax" promptText="Máx" prefWidth="60" />
                    <Label text="%" styleClass="filter-separator" />
                </HBox>

                <Label text="Status:" styleClass="filter-label" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <ComboBox fx:id="filtroStatus" promptText="Todos status" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <HBox spacing="10.0" GridPane.rowIndex="1" GridPane.columnIndex="4" alignment="CENTER_RIGHT">
                    <Button fx:id="btn_limparFiltros" text="Limpar Filtros" styleClass="btn-secondary" />
                    <Button fx:id="btn_aplicarFiltros" text="Aplicar Filtros" styleClass="btn-primary" />
                </HBox>
            </GridPane>
        </VBox>

        <!-- ===== ESTATÍSTICAS ===== -->
        <HBox spacing="30.0" alignment="CENTER_LEFT">
            <padding>
                <Insets left="20.0" />
            </padding>
            <Label fx:id="estatisticasLabel" text="Carregando estatísticas..." styleClass="list-statistics" />
            <Label fx:id="alertasLabel" text="" styleClass="list-alertas" />
        </HBox>

        <!-- ===== TABELA ===== -->
        <VBox VBox.vgrow="ALWAYS">
            <TableView fx:id="tonersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colEquipamento" text="Equipamento" prefWidth="200" />
                    <TableColumn fx:id="colToner" text="Toner" prefWidth="180" />
                    <TableColumn fx:id="colDataInstalacao" text="Instalado em" prefWidth="110" />
                    <TableColumn fx:id="colPercentagem" text="Restante (%)" prefWidth="100" />
                    <TableColumn fx:id="colCiclos" text="Ciclos" prefWidth="80" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="90" />
                    <TableColumn fx:id="colDiasInstalado" text="Dias" prefWidth="70" />
                    <TableColumn fx:id="colUsuario" text="Instalado por" prefWidth="120" />
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="150" />
                </columns>
            </TableView>

            <!-- ===== PAGINAÇÃO ===== -->
            <HBox spacing="10.0" alignment="CENTER" styleClass="pagination-bar">
                <Button fx:id="btn_primeira" text="<<<" styleClass="btn-pagination" />
                <Button fx:id="btn_anterior" text="<" styleClass="btn-pagination" />
                <Label fx:id="labelPagina" text="Página 1 de 1" styleClass="pagination-label" />
                <Button fx:id="btn_proxima" text=">" styleClass="btn-pagination" />
                <Button fx:id="btn_ultima" text=">>>" styleClass="btn-pagination" />
                <ComboBox fx:id="comboItensPorPagina" prefWidth="80.0" />
            </HBox>
        </VBox>

        <!-- ===== STATUS BAR ===== -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
            <Label fx:id="statusLabel" text="Pronto" styleClass="status-text" />
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="progressIndicator" progress="0.0" visible="false" />
        </HBox>
    </VBox>
</AnchorPane>
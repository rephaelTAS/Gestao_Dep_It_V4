<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0"
            styleClass="toner-dashboard-root"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20.0">

            <!-- ===== HEADER ===== -->
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label text="📊 Dashboard de Gestão de Toners" styleClass="dashboard-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btn_atualizar" text="🔄 Atualizar" styleClass="btn-primary" />
            </HBox>

            <!-- ===== CARDS ===== -->
            <HBox alignment="CENTER" spacing="15.0">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>

                <VBox spacing="10.0" styleClass="dashboard-card-green">
                    <Label text="🖨️" style="-fx-font-size: 24px;" />
                    <Label fx:id="cardAtivos" text="0" styleClass="dashboard-card-value" />
                    <Label text="Toners Ativos" styleClass="dashboard-card-label" />
                </VBox>

                <VBox spacing="10.0" styleClass="dashboard-card-red">
                    <Label text="⚠️" style="-fx-font-size: 24px;" />
                    <Label fx:id="cardAlertas" text="0" styleClass="dashboard-card-value" />
                    <Label text="Necessitam Troca" styleClass="dashboard-card-label" />
                </VBox>

                <VBox spacing="10.0" styleClass="dashboard-card-blue">
                    <Label text="📈" style="-fx-font-size: 24px;" />
                    <Label fx:id="cardMediaUso" text="0%" styleClass="dashboard-card-value" />
                    <Label text="Média de Uso" styleClass="dashboard-card-label" />
                </VBox>

                <VBox spacing="10.0" styleClass="dashboard-card-purple">
                    <Label text="🔄" style="-fx-font-size: 24px;" />
                    <Label fx:id="cardCiclosMedios" text="0" styleClass="dashboard-card-value" />
                    <Label text="Ciclos Médios" styleClass="dashboard-card-label" />
                </VBox>
            </HBox>

            <!-- ===== GRÁFICO + ALERTAS ===== -->
            <HBox alignment="TOP_LEFT" spacing="20.0">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>

                <VBox prefWidth="600.0" spacing="10.0">
                    <VBox spacing="10.0" styleClass="dashboard-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Distribuição por Nível de Toner" styleClass="dashboard-card-title" />
                        <PieChart fx:id="distribuicaoChart" styleClass="pie-chart" />
                    </VBox>
                </VBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <VBox spacing="10.0" styleClass="dashboard-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="🔔 Alertas de Toners" styleClass="dashboard-card-title" />
                        <ListView fx:id="alertasListView" prefHeight="200.0" styleClass="alert-list" />
                    </VBox>

                    <VBox spacing="10.0" styleClass="dashboard-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="⚡ Ações Rápidas" styleClass="dashboard-card-title" />
                        <VBox spacing="8.0">
                            <Button fx:id="btn_relatorio" text="📋 Gerar Relatório" styleClass="btn-dark" />
                            <Button fx:id="btn_substituicoes" text="🔄 Planejar Substituições" styleClass="btn-warning" />
                            <Button fx:id="btn_listaToner" text="Ver Lista Toner Usado" styleClass="btn-secondary" />
                            <Button fx:id="btn_estoque" text="📦 Ver Estoque Toners" styleClass="btn-success" />
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ===== TONERS CRÍTICOS ===== -->
            <VBox spacing="10.0">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
                <Label text="🚨 Toners que Necessitam Atenção Imediata" styleClass="dashboard-section-title" />

                <TableView fx:id="tonersCriticosTable" prefHeight="200.0" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colCriticoEquipamento" prefWidth="200" text="Equipamento" />
                        <TableColumn fx:id="colCriticoToner" prefWidth="150" text="Toner" />
                        <TableColumn fx:id="colCriticoPercentagem" prefWidth="80" text="%" />
                        <TableColumn fx:id="colCriticoDias" prefWidth="80" text="Dias" />
                        <TableColumn fx:id="colCriticoAcao" prefWidth="120" text="Ação" />
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
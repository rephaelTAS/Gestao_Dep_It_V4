<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="650.0" prefWidth="800.0"
            styleClass="toner-form-root">

    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20.0">

            <!-- ===== HEADER ===== -->
            <Label fx:id="tituloLabel" text="Nova Instalação de Toner" styleClass="form-title">
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
                </padding>
            </Label>

            <!-- ===== SELEÇÃO EQUIPAMENTO ===== -->
            <VBox spacing="10.0" styleClass="form-section-equipamento">
                <padding>
                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                </padding>
                <Label text="Equipamento de Destino" styleClass="form-section-title-blue" />
                <Label fx:id="equipamentoInfoLabel" text="Nenhum equipamento selecionado" styleClass="form-product-text" />
                <Label fx:id="tonerAtualLabel" text="Toner atual: Nenhum" styleClass="form-toner-atual" />
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button fx:id="btn_selecionarEquipamento" text="Selecionar Equipamento" styleClass="btn-primary" />
                    <Button fx:id="btn_limparEquipamento" text="Limpar Seleção" styleClass="btn-secondary" />
                </HBox>
            </VBox>

            <!-- ===== SELEÇÃO TONER ===== -->
            <VBox spacing="10.0" styleClass="form-section-toner">
                <padding>
                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                </padding>
                <Label text="Toner para Instalação" styleClass="form-section-title-warning" />
                <Label fx:id="tonerInfoLabel" text="Nenhum toner selecionado" styleClass="form-product-text" />
                <Label fx:id="estoqueTonerLabel" text="Estoque disponível: -" styleClass="form-estoque-label" />
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button fx:id="btn_selecionarToner" text="Selecionar Toner" styleClass="btn-warning" />
                    <Button fx:id="btn_limparToner" text="Limpar Seleção" styleClass="btn-secondary" />
                </HBox>
            </VBox>

            <!-- ===== FORMULÁRIO ===== -->
            <GridPane hgap="15.0" vgap="15.0" styleClass="form-grid">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="180.0" prefWidth="180.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" prefWidth="250.0" />
                </columnConstraints>

                <Label text="Data de Instalação *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <DatePicker fx:id="dataInstalacao" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Percentagem Restante *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <HBox spacing="10.0" GridPane.rowIndex="1" GridPane.columnIndex="1">
                    <Slider fx:id="percentagemSlider" min="0" max="100" value="100"
                            showTickLabels="true" showTickMarks="true" majorTickUnit="25"
                            HBox.hgrow="ALWAYS" styleClass="toner-slider" />
                    <Label fx:id="percentagemLabel" text="100%" styleClass="toner-slider-label" />
                </HBox>

                <Label text="Ciclos de Impressão" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextField fx:id="ciclosImpressao" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Observações" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <TextArea fx:id="observacoes" promptText="Observações sobre a instalação"
                          wrapText="true" prefRowCount="3" GridPane.rowIndex="3" GridPane.columnIndex="1" />
            </GridPane>

            <!-- ===== COMPATIBILIDADE ===== -->
            <VBox spacing="10.0" styleClass="form-section-compatibilidade">
                <padding>
                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                </padding>
                <Label text="Verificação de Compatibilidade" styleClass="form-section-title-green" />
                <VBox spacing="8.0">
                    <Label fx:id="compatibilidadeLabel" text="Selecione equipamento e toner para verificar compatibilidade" />
                    <Label fx:id="vidaUtilLabel" text="Vida útil estimada: -" styleClass="form-hint" />
                </VBox>
            </VBox>

            <!-- ===== MENSAGEM DE ERRO ===== -->
            <Label fx:id="mensagemErroLabel" styleClass="form-message-error"
                   visible="false" managed="false" maxWidth="1.7976931348623157E308">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>
            </Label>

            <!-- ===== BOTÕES ===== -->
            <HBox spacing="15.0" alignment="CENTER_RIGHT">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                </padding>
                <Button fx:id="btn_cancelar" text="Cancelar" styleClass="btn-secondary" />
                <Button fx:id="btn_salvar" text="Registrar Instalação" styleClass="btn-success" />
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
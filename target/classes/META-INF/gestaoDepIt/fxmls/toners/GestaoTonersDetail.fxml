<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="700.0" prefWidth="1000.0"
            styleClass="toner-detail-root">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20.0">

            <!-- ===== HEADER ===== -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Button fx:id="btn_voltar" text="← Voltar" styleClass="btn-secondary" />
                <VBox spacing="2.0">
                    <Label fx:id="tituloLabel" text="Detalhes da Instalação de Toner" styleClass="toner-detail-title" />
                    <Label fx:id="subtituloLabel" text="ID: -" styleClass="toner-detail-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <Button fx:id="btn_editar" text="Editar" styleClass="btn-warning" />
                    <Button fx:id="btn_atualizarUso" text="Atualizar Uso" styleClass="btn-primary" />
                    <Button fx:id="btn_substituir" text="Substituir" styleClass="btn-danger" />
                </HBox>
            </HBox>

            <!-- ===== CONTEÚDO ===== -->
            <HBox spacing="20.0" alignment="TOP_LEFT">
                <padding>
                    <Insets left="20.0" right="20.0" />
                </padding>

                <!-- ===== COLUNA ESQUERDA ===== -->
                <VBox spacing="20.0" prefWidth="400.0">

                    <!-- Dados da Instalação -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Dados da Instalação" styleClass="detail-card-header" />

                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>

                            <Label text="ID:" styleClass="label-bold" GridPane.rowIndex="0" />
                            <Label fx:id="detailId" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Equipamento:" styleClass="label-bold" GridPane.rowIndex="1" />
                            <Label fx:id="detailEquipamento" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Toner:" styleClass="label-bold" GridPane.rowIndex="2" />
                            <Label fx:id="detailToner" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Data Instalação:" styleClass="label-bold" GridPane.rowIndex="3" />
                            <Label fx:id="detailDataInstalacao" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Dias Instalado:" styleClass="label-bold" GridPane.rowIndex="4" />
                            <Label fx:id="detailDiasInstalado" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Instalado por:" styleClass="label-bold" GridPane.rowIndex="5" />
                            <Label fx:id="detailUsuario" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Status do Toner -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Status do Toner" styleClass="detail-card-header" />

                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>

                            <Label text="Percentagem:" styleClass="label-bold" GridPane.rowIndex="0" />
                            <Label fx:id="detailPercentagem" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Ciclos:" styleClass="label-bold" GridPane.rowIndex="1" />
                            <Label fx:id="detailCiclos" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Status:" styleClass="label-bold" GridPane.rowIndex="2" />
                            <Label fx:id="detailStatus" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Vida Útil:" styleClass="label-bold" GridPane.rowIndex="3" />
                            <Label fx:id="detailVidaUtil" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Observações -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Observações" styleClass="detail-card-header" />
                        <TextArea fx:id="detailObservacoes" wrapText="true" editable="false"
                                  prefRowCount="3" styleClass="detail-textarea" />
                    </VBox>
                </VBox>

                <!-- ===== COLUNA DIREITA ===== -->
                <VBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <!-- Barra de Progresso -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Nível do Toner" styleClass="detail-card-header" />

                        <VBox spacing="10.0" alignment="CENTER">
                            <ProgressBar fx:id="progressBar" progress="1.0" styleClass="toner-progress" />
                            <Label fx:id="progressLabel" text="100%" styleClass="toner-progress-label" />
                            <Label fx:id="alertaLabel" text="" styleClass="toner-alerta" />
                        </VBox>
                    </VBox>

                    <!-- Estatísticas -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Estatísticas de Uso" styleClass="detail-card-header" />

                        <VBox spacing="8.0">
                            <Label fx:id="statCiclosDia" text="Ciclos/dia: Carregando..." />
                            <Label fx:id="statProjecao" text="Projeção de troca: Carregando..." />
                            <Label fx:id="statHistorico" text="Histórico equipamento: Carregando..." />
                        </VBox>
                    </VBox>

                    <!-- Ações Rápidas -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <Label text="Ações Rápidas" styleClass="detail-card-header" />

                        <VBox spacing="8.0">
                            <Button fx:id="btn_registrarUso" text="Registrar Uso" styleClass="btn-primary" />
                            <Button fx:id="btn_ajustarPercentagem" text="Ajustar Percentagem" styleClass="btn-warning" />
                            <Button fx:id="btn_verHistorico" text="Ver Histórico" styleClass="btn-purple" />
                            <Button fx:id="btn_marcarEsgotado" text="Marcar como Esgotado" styleClass="btn-danger" />
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Status -->
            <Label fx:id="mensagemStatusLabel" styleClass="toner-status-message"
                   visible="false" managed="false" maxWidth="1.7976931348623157E308">
                <padding>
                    <Insets left="20.0" right="20.0" bottom="20.0" />
                </padding>
            </Label>
        </VBox>
    </ScrollPane>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" prefHeight="400.0" prefWidth="600.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="notificacao-detalhe-root">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Detalhes da Notificação:" styleClass="detalhe-title" />

    <ScrollPane fitToWidth="true" styleClass="detalhe-scroll" VBox.vgrow="ALWAYS">
        <content>
            <Label fx:id="labelConteudoNotificacao"
                   text="Aqui aparecerão os detalhes completos da notificação."
                   wrapText="true"
                   styleClass="detalhe-conteudo" />
        </content>
    </ScrollPane>

    <AnchorPane maxHeight="40.0" minHeight="40.0" prefHeight="50.0" prefWidth="560.0">
        <children>
            <Button fx:id="btn_fechar" layoutX="14.0" layoutY="7.0" text="Fechar" styleClass="btn-secondary" AnchorPane.topAnchor="10.0" />
            <Button fx:id="btn_resolvido" layoutX="135.0" layoutY="7.0" text="Resolvido" styleClass="btn-success" AnchorPane.topAnchor="10.0" />
        </children>
    </AnchorPane>
</VBox>
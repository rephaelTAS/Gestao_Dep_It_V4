<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefHeight="800.0" prefWidth="320.0"
            minWidth="280.0" maxWidth="400.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1">

    <BorderPane AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                styleClass="notificacao-root">

        <!-- ===== HEADER ===== -->
        <top>
            <VBox spacing="8" styleClass="notificacao-header">
                <padding>
                    <Insets top="20" right="20" bottom="15" left="20"/>
                </padding>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="🔔" styleClass="notificacao-icon"/>
                    <VBox spacing="2">
                        <Label text="Notificações" styleClass="notificacao-title"/>
                        <Label fx:id="lblContador" text="0 novas" styleClass="notificacao-subtitle"/>
                    </VBox>
                </HBox>

                <HBox spacing="8" styleClass="notificacao-filtros">
                    <Button fx:id="btn_filtrarTodas" text="Todas" styleClass="filter-btn" />
                    <Button fx:id="btn_filtrarNaoLidas" text="Não Lidas" styleClass="filter-btn" />
                    <Button fx:id="btn_filtrarCriticas" text="Críticas" styleClass="filter-btn" />
                </HBox>
            </VBox>
        </top>

        <!-- ===== CENTER ===== -->
        <center>
            <VBox spacing="0">

                <!-- Estado Vazio -->
                <StackPane fx:id="paneVazio" visible="false" styleClass="empty-state">
                    <VBox alignment="CENTER" spacing="12">
                        <Label text="📨" styleClass="empty-icon"/>
                        <Label text="Nenhuma Notificação" styleClass="empty-title"/>
                        <Label text="Você está atualizado!" styleClass="empty-subtitle"/>
                    </VBox>
                </StackPane>

                <!-- ListView -->
                <ListView fx:id="listaNotificacoes"
                          styleClass="notificacao-listview"
                          VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="Carregando notificações..." styleClass="loading-label"/>
                    </placeholder>
                </ListView>
            </VBox>
        </center>

        <!-- ===== FOOTER ===== -->
        <bottom>
            <VBox spacing="12" styleClass="notificacao-footer">

                <!-- Estatísticas -->
                <HBox spacing="15" alignment="CENTER" styleClass="notificacao-stats">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Rectangle width="8" height="8" styleClass="stat-critical"/>
                        <Label fx:id="lblCriticas" text="0" styleClass="stat-count"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Rectangle width="8" height="8" styleClass="stat-warning"/>
                        <Label fx:id="lblAvisos" text="0" styleClass="stat-count"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Rectangle width="8" height="8" styleClass="stat-info"/>
                        <Label fx:id="lblInformacoes" text="0" styleClass="stat-count"/>
                    </HBox>
                </HBox>

                <!-- Botões de Ação -->
                <HBox spacing="10" alignment="CENTER" styleClass="notificacao-actions">
                    <Button fx:id="btn_marcarTodasLidas" text="📋 Marcar Todas" styleClass="btn-secondary" />
                    <Button fx:id="btn_limparTodas" text="🗑️ Limpar Todas" styleClass="btn-primary" />
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="700" prefWidth="1100"
            styleClass="relatorio-simples-root">

    <VBox spacing="16" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0"
          styleClass="relatorio-simples-container">

        <!-- ===== CABEÇALHO ===== -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="header-card">
            <Label text="📊" style="-fx-font-size: 28px;" />
            <VBox spacing="3">
                <Label text="Relatório Simples" styleClass="page-title" />
                <Label text="Selecione uma tabela, aplique filtros e exporte para Excel"
                       styleClass="page-subtitle" />
            </VBox>
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_exportarExcel" text="📥 Exportar Excel" styleClass="btn-success" />
        </HBox>

        <!-- ===== CONFIGURAÇÃO ===== -->
        <VBox spacing="12" styleClass="config-card">

            <Label text="⚙️ Configuração do Relatório" styleClass="config-title" />

            <HBox spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Tabela de Dados:" styleClass="config-label" />
                    <ComboBox fx:id="comboTabela" prefWidth="220" promptText="Selecione a tabela..." />
                </VBox>

                <VBox spacing="5">
                    <Label fx:id="labelFiltro1" text="Status:" styleClass="config-label" />
                    <ComboBox fx:id="comboFiltro1" prefWidth="180" promptText="Todos..." />
                </VBox>

                <VBox spacing="5">
                    <Label text="Período:" styleClass="config-label" />
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <DatePicker fx:id="dpInicio" prefWidth="130" promptText="Data início" />
                        <Label text="até" styleClass="filter-separator" />
                        <DatePicker fx:id="dpFim" prefWidth="130" promptText="Data fim" />
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="⠀" styleClass="config-label" />
                    <Button fx:id="btn_gerarRelatorio" text="🔍 Gerar Relatório" styleClass="btn-primary" />
                </VBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <CheckBox fx:id="checkApenasAtivos" text="Apenas registros ativos" styleClass="config-checkbox" />
                <CheckBox fx:id="checkIncluirCabecalho" text="Incluir cabeçalho no Excel" selected="true" styleClass="config-checkbox" />
            </HBox>
        </VBox>

        <!-- ===== TABELA ===== -->
        <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="table-card">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="📋 Dados do Relatório" styleClass="table-title" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotalRegistros" text="0 registros" styleClass="table-total" />
            </HBox>

            <TableView fx:id="tabelaResultados" VBox.vgrow="ALWAYS" styleClass="table-view">
                <placeholder>
                    <Label text="Selecione uma tabela e clique em 'Gerar Relatório' para visualizar os dados."
                           styleClass="table-placeholder" />
                </placeholder>
                <columnResizePolicy>
                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- ===== STATUS BAR ===== -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="lblStatus" text="Pronto para gerar relatório." styleClass="status-text" />
            <Pane HBox.hgrow="ALWAYS" />
            <Label fx:id="lblFiltroAtivo" text="Nenhum filtro aplicado" styleClass="status-filter" />
        </HBox>
    </VBox>
</AnchorPane>
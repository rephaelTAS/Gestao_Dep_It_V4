<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="750.0" prefWidth="1000.0">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20" styleClass="detail-root">

            <!-- ========== HEADER ========== -->
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="detail-header">
                <padding>
                    <Insets bottom="10" left="20" right="20" top="20" />
                </padding>
                <Button fx:id="btn_voltar" text="← Voltar" styleClass="btn-secondary" />
                <VBox spacing="2">
                    <Label fx:id="tituloLabel" text="Detalhes do Produto" styleClass="detail-title" />
                    <Label fx:id="subtituloLabel" text="SKU: -" styleClass="detail-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10">
                    <Button fx:id="btn_editar" text="Editar" styleClass="btn-primary" />
                    <Button fx:id="btn_desativar" text="Desativar" styleClass="btn-danger" />
                </HBox>
            </HBox>

            <!-- ========== CONTENT ========== -->
            <HBox spacing="20" alignment="TOP_LEFT">
                <padding>
                    <Insets left="20" right="20" />
                </padding>

                <!-- ========== LEFT COLUMN ========== -->
                <VBox spacing="15" prefWidth="550">

                    <!-- Card: Informações do Produto -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Informações do Produto" styleClass="detail-card-header" />
                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="140" prefWidth="140" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                            </columnConstraints>

                            <Label text="SKU:" GridPane.rowIndex="0" />
                            <Label fx:id="detailSku" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="detail-value" />

                            <Label text="Tipo:" GridPane.rowIndex="1" />
                            <Label fx:id="detailTipo" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Categoria:" GridPane.rowIndex="2" />
                            <Label fx:id="detailCategoria" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                            <Label text="Marca:" GridPane.rowIndex="3" />
                            <Label fx:id="detailMarca" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                            <Label text="Modelo:" GridPane.rowIndex="4" />
                            <Label fx:id="detailModelo" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                            <Label text="Cor:" GridPane.rowIndex="5" />
                            <Label fx:id="detailCor" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                            <Label text="Preço Unitário:" GridPane.rowIndex="6" />
                            <Label fx:id="detailPrecoUnitario" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                            <Label text="IVA:" GridPane.rowIndex="7" />
                            <Label fx:id="detailIva" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                            <Label text="Preço Total:" GridPane.rowIndex="8" />
                            <Label fx:id="detailPrecoTotal" GridPane.rowIndex="8" GridPane.columnIndex="1" />

                            <Label text="Estoque:" GridPane.rowIndex="9" />
                            <Label fx:id="detailEstoque" GridPane.rowIndex="9" GridPane.columnIndex="1" />

                            <Label text="Status:" GridPane.rowIndex="10" />
                            <Label fx:id="detailStatus" GridPane.rowIndex="10" GridPane.columnIndex="1" />

                            <Label text="Fornecedor:" GridPane.rowIndex="11" />
                            <Label fx:id="detailFornecedor" GridPane.rowIndex="11" GridPane.columnIndex="1" />

                            <Label text="Nº Fatura:" GridPane.rowIndex="12" />
                            <Label fx:id="detailNumeroFatura" GridPane.rowIndex="12" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Card: Descrição -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Descrição" styleClass="detail-card-header" />
                        <TextArea fx:id="detailDescricao" wrapText="true" editable="false" prefRowCount="4" styleClass="detail-textarea" />
                    </VBox>

                    <!-- Card: Características Técnicas -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Características Técnicas" styleClass="detail-card-header" />
                        <TextArea fx:id="detailCaracteristicas" wrapText="true" editable="false" prefRowCount="6" styleClass="detail-textarea" />
                    </VBox>

                    <!-- Card: Fatura de Compra -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Fatura de Compra" styleClass="detail-card-header" />
                        <VBox spacing="8">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Anexo:" styleClass="label-bold" />
                                <Label fx:id="detailFaturaStatus" text="Sem anexo" />
                            </HBox>
                            <HBox spacing="10">
                                <Button fx:id="btn_baixarFatura" text="📥 Baixar Fatura"
                                        styleClass="btn-primary" disable="true" />
                                <Button fx:id="btn_abrirFatura" text="👁 Abrir Fatura"
                                        styleClass="btn-secondary" disable="true" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ========== RIGHT COLUMN ========== -->
                <VBox spacing="15" VBox.vgrow="ALWAYS">

                    <!-- Card: Informações Financeiras -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Informações Financeiras" styleClass="detail-card-header" />
                        <VBox spacing="8">
                            <HBox spacing="10">
                                <Label text="Valor Total em Estoque:" styleClass="label-bold" />
                                <Label fx:id="statValorTotal" text="€ 0,00" styleClass="value-highlight" />
                            </HBox>
                            <HBox spacing="10">
                                <Label text="Preço Unitário:" styleClass="label-bold" />
                                <Label fx:id="statPrecoUnitario" text="€ 0,00" />
                            </HBox>
                            <HBox spacing="10">
                                <Label text="IVA:" styleClass="label-bold" />
                                <Label fx:id="statIva" text="0%" />
                            </HBox>
                            <HBox spacing="10">
                                <Label text="Quantidade em Estoque:" styleClass="label-bold" />
                                <Label fx:id="statQuantidadeEstoque" text="0 unidades" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- Card: Estatísticas -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Estatísticas" styleClass="detail-card-header" />
                        <VBox spacing="8">
                            <Label fx:id="statEquipamentos" text="Equipamentos: -" />
                            <Label fx:id="statMovimentacoes" text="Movimentações: -" />
                            <Label fx:id="statToners" text="Toners: -" />
                        </VBox>
                    </VBox>

                    <!-- Card: Datas -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Datas" styleClass="detail-card-header" />
                        <GridPane hgap="10" vgap="8">
                            <Label text="Criado em:" GridPane.rowIndex="0" />
                            <Label fx:id="detailCriadoEm" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            <Label text="Atualizado em:" GridPane.rowIndex="1" />
                            <Label fx:id="detailAtualizadoEm" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Card: Ações Rápidas -->
                    <VBox spacing="10" styleClass="detail-card">
                        <Label text="Ações Rápidas" styleClass="detail-card-header" />
                        <VBox spacing="8">
                            <Button fx:id="btn_ajustarEstoque" text="Ajustar Estoque" styleClass="btn-primary" />
                            <Button fx:id="btn_atualizarPreco" text="Atualizar Preço" styleClass="btn-secondary" />
                            <Button fx:id="btn_movimentar" text="Registrar Movimentação" styleClass="btn-secondary" />
                            <Button fx:id="btn_historico" text="Ver Histórico" styleClass="btn-secondary" />
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </ScrollPane>
</AnchorPane>
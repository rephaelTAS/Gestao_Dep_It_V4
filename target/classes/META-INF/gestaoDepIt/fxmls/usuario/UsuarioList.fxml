<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="800.0" prefWidth="1200.0"
            styleClass="usuario-list-root">

    <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Gestão de Usuários do Sistema" styleClass="list-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_novoUsuario" text="+ Novo Usuário" styleClass="btn-primary" />
        </HBox>

        <!-- ===== FILTROS ===== -->
        <VBox spacing="10.0" styleClass="list-card">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="Filtros de Usuários" styleClass="list-card-header" />

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="120.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                </columnConstraints>

                <Label text="Nome:" styleClass="filter-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="filtroNome" promptText="Buscar por nome..." GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Email:" styleClass="filter-label" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                <TextField fx:id="filtroEmail" promptText="Buscar por email..." GridPane.rowIndex="0" GridPane.columnIndex="3" />

                <Label text="Nível:" styleClass="filter-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="filtroNivel" promptText="Todos níveis" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Status:" styleClass="filter-label" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                <ComboBox fx:id="filtroStatus" promptText="Todos status" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                <Label text="Sessão:" styleClass="filter-label" GridPane.rowIndex="1" GridPane.columnIndex="4" />
                <ComboBox fx:id="filtroSessao" promptText="Todas" GridPane.rowIndex="1" GridPane.columnIndex="5" />

                <HBox spacing="10.0" GridPane.rowIndex="2" GridPane.columnIndex="3"
                      alignment="CENTER_RIGHT" GridPane.columnSpan="3">
                    <Button fx:id="btn_limparFiltros" text="Limpar Filtros" styleClass="btn-secondary" />
                    <Button fx:id="btn_aplicarFiltros" text="Aplicar Filtros" styleClass="btn-primary" />
                </HBox>
            </GridPane>
        </VBox>

        <!-- ===== ESTATÍSTICAS ===== -->
        <HBox spacing="30.0" alignment="CENTER_LEFT">
            <padding><Insets left="20.0" /></padding>
            <Label fx:id="estatisticasLabel" text="Carregando estatísticas..." styleClass="list-statistics" />
            <Label fx:id="sessoesAtivasLabel" text="" styleClass="list-active-filters" />
        </HBox>

        <!-- ===== TABELA ===== -->
        <VBox VBox.vgrow="ALWAYS">
            <TableView fx:id="usuariosTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colNome" text="Nome" prefWidth="180.0" />
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200.0" />
                    <TableColumn fx:id="colFuncionario" text="Funcionário" prefWidth="120.0" />
                    <TableColumn fx:id="colNivelAcesso" text="Nível" prefWidth="100.0" />
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="80.0" />
                    <TableColumn fx:id="colUltimoLogin" text="Último Login" prefWidth="140.0" />
                    <TableColumn fx:id="colIpLogin" text="IP Login" prefWidth="120.0" />
                    <TableColumn fx:id="colSessaoAtiva" text="Sessão" prefWidth="80.0" />
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="150.0" />
                </columns>
            </TableView>

            <!-- ===== PAGINAÇÃO ===== -->
            <HBox spacing="10.0" alignment="CENTER" styleClass="pagination-bar">
                <Button fx:id="btn_primeira" text="<<<" styleClass="btn-pagination" />
                <Button fx:id="btn_anterior" text="<" styleClass="btn-pagination" />
                <Label fx:id="labelPagina" text="Página 1 de 1" styleClass="pagination-label" />
                <Button fx:id="btn_proxima" text=">" styleClass="btn-pagination" />
                <Button fx:id="btn_ultima" text=">>>" styleClass="btn-pagination" />
                <ComboBox fx:id="comboItensPorPagina" prefWidth="80.0" />
            </HBox>
        </VBox>

        <!-- ===== STATUS BAR ===== -->
        <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding><Insets left="20.0" right="20.0" /></padding>
            <Label fx:id="statusLabel" text="Pronto" styleClass="status-text" />
            <Region HBox.hgrow="ALWAYS" />
            <ProgressIndicator fx:id="progressIndicator" progress="0.0" visible="false" />
        </HBox>
    </VBox>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/11.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="750.0" prefWidth="1050.0"
            styleClass="usuario-detail-root">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="20.0">

            <!-- ===== HEADER ===== -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding><Insets bottom="10.0" left="20.0" right="20.0" top="20.0" /></padding>
                <Button fx:id="btn_voltar" text="← Voltar" styleClass="btn-secondary" />
                <VBox spacing="2.0">
                    <Label fx:id="tituloLabel" text="Detalhes do Usuário" styleClass="page-title" />
                    <Label fx:id="subtituloLabel" text="Email: -" styleClass="page-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <Button fx:id="btn_alterarSenha" text="🔑 Alterar Senha" styleClass="btn-primary" />
                    <Button fx:id="btn_redefinirSenha" text="🔄 Redefinir Senha" styleClass="btn-warning" />
                    <Button fx:id="btn_desativar" text="Desativar" styleClass="btn-danger" />
                </HBox>
            </HBox>

            <!-- ===== CONTEÚDO ===== -->
            <HBox spacing="20.0" alignment="TOP_LEFT">
                <padding><Insets left="20.0" right="20.0" /></padding>

                <!-- ===== COLUNA ESQUERDA ===== -->
                <VBox spacing="20.0" prefWidth="400.0">

                    <!-- Dados do Usuário -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="Dados do Usuário" styleClass="detail-card-header" />
                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>
                            <Label text="ID:" styleClass="label-bold" GridPane.rowIndex="0" />
                            <Label fx:id="detailId" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            <Label text="Nome:" styleClass="label-bold" GridPane.rowIndex="1" />
                            <Label fx:id="detailNome" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            <Label text="Email:" styleClass="label-bold" GridPane.rowIndex="2" />
                            <Label fx:id="detailEmail" styleClass="value-highlight" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            <Label text="Funcionário:" styleClass="label-bold" GridPane.rowIndex="3" />
                            <Label fx:id="detailFuncionario" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                            <Label text="Nível Acesso:" styleClass="label-bold" GridPane.rowIndex="4" />
                            <Label fx:id="detailNivelAcesso" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                            <Label text="Status:" styleClass="label-bold" GridPane.rowIndex="5" />
                            <Label fx:id="detailStatus" GridPane.rowIndex="5" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Informações do Sistema -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="Informações do Sistema" styleClass="detail-card-header" />
                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>
                            <Label text="Criado em:" styleClass="label-bold" GridPane.rowIndex="0" />
                            <Label fx:id="detailCriadoEm" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            <Label text="Atualizado em:" styleClass="label-bold" GridPane.rowIndex="1" />
                            <Label fx:id="detailAtualizadoEm" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- ===== COLUNA DIREITA ===== -->
                <VBox spacing="20.0" VBox.vgrow="ALWAYS">

                    <!-- Segurança e Acesso -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="Segurança e Acesso" styleClass="detail-card-header" />
                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>
                            <Label text="Último Login:" styleClass="label-bold" GridPane.rowIndex="0" />
                            <Label fx:id="detailUltimoLogin" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                            <Label text="IP Último Login:" styleClass="label-bold" GridPane.rowIndex="1" />
                            <Label fx:id="detailIpLogin" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                            <Label text="Sessão Ativa:" styleClass="label-bold" GridPane.rowIndex="2" />
                            <Label fx:id="detailSessaoAtiva" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                            <Label text="Expira Sessão:" styleClass="label-bold" GridPane.rowIndex="3" />
                            <Label fx:id="detailExpiraSessao" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                        </GridPane>
                    </VBox>

                    <!-- Estatísticas -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="Estatísticas de Atividade" styleClass="detail-card-header" />
                        <VBox spacing="8.0">
                            <Label fx:id="statEventos" text="Eventos Registrados: —" />
                            <Label fx:id="statMovimentacoes" text="Movimentações: —" />
                            <Label fx:id="statLogin30dias" text="Logins (30 dias): —" />
                        </VBox>
                    </VBox>

                    <!-- Ações de Segurança -->
                    <VBox spacing="10.0" styleClass="detail-card">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="Ações de Segurança" styleClass="detail-card-header" />
                        <VBox spacing="8.0">
                            <Button fx:id="btn_forcarLogout" text="Forçar Logout" styleClass="btn-danger" />
                            <Button fx:id="btn_auditarUsuario" text="Auditar Atividade" styleClass="btn-dark" />
                            <Button fx:id="btn_alterarNivel" text="Alterar Nível Acesso" styleClass="btn-purple" />
                        </VBox>
                    </VBox>

                    <!-- ===== PAINEL ALTERAR SENHA ===== -->
                    <VBox fx:id="alterarSenhaPanel" spacing="10.0" styleClass="detail-card"
                          visible="false" managed="false">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="🔑 Alterar Senha" styleClass="detail-card-header" />
                        <Label text="Usuário sabe a senha atual" styleClass="hint-label" />

                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0" prefWidth="130.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>

                            <Label text="Senha Atual *" styleClass="label-bold"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <PasswordField fx:id="alterarSenhaAtual" promptText="Digite a senha atual"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Nova Senha *" styleClass="label-bold"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <PasswordField fx:id="alterarNovaSenha" promptText="Mínimo 6 caracteres"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" />

                            <Label text="Confirmar *" styleClass="label-bold"
                                   GridPane.rowIndex="2" GridPane.columnIndex="0" />
                            <PasswordField fx:id="alterarConfirmarSenha" promptText="Confirme a nova senha"
                                           GridPane.rowIndex="2" GridPane.columnIndex="1" />
                        </GridPane>

                        <Label fx:id="alterarSenhaErro" styleClass="form-message-error"
                               visible="false" managed="false" />

                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <Button fx:id="btn_cancelarAlterar" text="Cancelar" styleClass="btn-secondary" />
                            <Button fx:id="btn_salvarAlterar" text="Salvar" styleClass="btn-success" />
                        </HBox>
                    </VBox>

                    <!-- ===== PAINEL REDEFINIR SENHA ===== -->
                    <VBox fx:id="redefinirSenhaPanel" spacing="10.0" styleClass="detail-card"
                          visible="false" managed="false">
                        <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                        <Label text="🔄 Redefinir Senha" styleClass="detail-card-header" />
                        <Label text="Redefinição administrativa — não requer senha atual" styleClass="hint-label" />

                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="130.0" prefWidth="130.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                            </columnConstraints>

                            <Label text="Nova Senha *" styleClass="label-bold"
                                   GridPane.rowIndex="0" GridPane.columnIndex="0" />
                            <PasswordField fx:id="redefinirNovaSenha" promptText="Mínimo 6 caracteres"
                                           GridPane.rowIndex="0" GridPane.columnIndex="1" />

                            <Label text="Confirmar *" styleClass="label-bold"
                                   GridPane.rowIndex="1" GridPane.columnIndex="0" />
                            <PasswordField fx:id="redefinirConfirmarSenha" promptText="Confirme a nova senha"
                                           GridPane.rowIndex="1" GridPane.columnIndex="1" />
                        </GridPane>

                        <Label fx:id="redefinirSenhaErro" styleClass="form-message-error"
                               visible="false" managed="false" />

                        <HBox spacing="10.0" alignment="CENTER_RIGHT">
                            <Button fx:id="btn_cancelarRedefinir" text="Cancelar" styleClass="btn-secondary" />
                            <Button fx:id="btn_salvarRedefinir" text="Redefinir" styleClass="btn-success" />
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ===== STATUS ===== -->
            <Label fx:id="mensagemStatusLabel" styleClass="status-message"
                   visible="false" managed="false" maxWidth="1.7976931348623157E308">
                <padding><Insets left="20.0" right="20.0" bottom="20.0" /></padding>
            </Label>
        </VBox>
    </ScrollPane>
</AnchorPane>
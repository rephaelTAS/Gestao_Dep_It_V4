<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Main.fxml v2.0
    Pergunta: Como é que a aplicação se organiza (shell global)?

    Estrutura: BorderPane com header, sidebar, content, aside opcional, footer.
    Classes: app-* (estrutura), ds-* (componentes), page-* (título de página),
             dashboard-* (específico do ecrã dashboard).
-->

<BorderPane fx:id="appShell"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21.0"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ===================================================== -->
    <!-- HEADER                                                 -->
    <!-- ===================================================== -->
    <top>
        <HBox alignment="CENTER_LEFT"
              styleClass="app-header"
              spacing="16">

            <padding>
                <Insets top="8" right="20" bottom="8" left="20"/>
            </padding>

            <!-- Toggle sidebar -->
            <Button fx:id="toggleSidebarBtn"
                    styleClass="ds-button, ds-button--icon, ds-button--ghost">
                <graphic>
                    <ImageView fx:id="menuIcon" fitHeight="20" fitWidth="20" preserveRatio="true"/>
                </graphic>
            </Button>

            <!-- Título da aplicação -->
            <Label text="Gestão de Equipamentos TI"
                   styleClass="app-header-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Contexto da página (breadcrumb) -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="app-breadcrumbs">
                <ImageView fx:id="pageIcon" fitHeight="18" fitWidth="18" preserveRatio="true"/>
                <Label fx:id="pageName" styleClass="app-breadcrumb-current" text="Dashboard"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Ações globais -->
            <HBox alignment="CENTER_RIGHT" spacing="8">

                <Button fx:id="btnSettings"
                        styleClass="ds-button, ds-button--icon, ds-button--ghost">
                    <graphic>
                        <ImageView fx:id="settingsIcon" fitHeight="18" fitWidth="18" preserveRatio="true"/>
                    </graphic>
                </Button>

                <Button fx:id="btnNotifications"
                        styleClass="ds-button, ds-button--icon, ds-button--ghost">
                    <graphic>
                        <ImageView fx:id="notificationIcon" fitHeight="18" fitWidth="18" preserveRatio="true"/>
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" prefHeight="24"/>

                <!-- Utilizador -->
                <HBox alignment="CENTER" spacing="10" styleClass="app-user">
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <HBox alignment="BASELINE_RIGHT" spacing="6">
                            <Label fx:id="timeLabel" styleClass="app-user-time" text="14:30"/>
                            <Label fx:id="dateLabel" styleClass="app-user-date" text="15/12/24"/>
                        </HBox>
                        <Label fx:id="userName" styleClass="app-user-name" text="Administrador"/>
                    </VBox>

                    <StackPane styleClass="app-avatar">
                        <Label fx:id="userInitials" styleClass="app-avatar-initials" text="A"/>
                        <ImageView fx:id="userImage" fitHeight="36" fitWidth="36"
                                   preserveRatio="true" styleClass="app-avatar-image"/>
                    </StackPane>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ===================================================== -->
    <!-- SIDEBAR                                                -->
    <!-- ===================================================== -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="240"
              styleClass="app-sidebar"
              BorderPane.alignment="CENTER">

            <!-- Marca -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="app-sidebar-brand">
                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true"/>
                <Label styleClass="app-sidebar-brand-title" text="TechManager Pro"/>
            </HBox>

            <!-- Menu (scroll) -->
            <ScrollPane fitToWidth="true"
                        fitToHeight="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="app-sidebar-scroll"
                        VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="menuContainer" spacing="2" styleClass="app-nav">

                        <Label styleClass="app-nav-section" text="PRINCIPAL"/>
                        <Button fx:id="btnDashboard"
                                maxWidth="Infinity"
                                styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Dashboard</text>
                        </Button>

                        <Label styleClass="app-nav-section" text="ESTOQUE"/>
                        <Button fx:id="btnCatalogo" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Catálogo</text>
                        </Button>
                        <Button fx:id="btnEstoque" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Movimentações</text>
                        </Button>
                        <Button fx:id="btnProdutoStock" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Produtos E Inventário</text>
                        </Button>

                        <Label styleClass="app-nav-section" text="EQUIPAMENTOS"/>
                        <Button fx:id="btnInventario" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Inventário</text>
                        </Button>
                        <Button fx:id="btnToners" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Toners</text>
                        </Button>

                        <Label styleClass="app-nav-section" text="PESSOAL"/>
                        <Button fx:id="btnFuncionarios" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Funcionários</text>
                        </Button>
                        <Button fx:id="btnUsuarios" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Usuários</text>
                        </Button>

                        <Label styleClass="app-nav-section" text="RELATÓRIOS"/>
                        <Button fx:id="btnRelatorio" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Relatórios</text>
                        </Button>
                        <Button fx:id="btnHistorico" maxWidth="Infinity" styleClass="app-nav-item">
                            <graphic><ImageView fitHeight="18" fitWidth="18" preserveRatio="true"/></graphic>
                            <text>Histórico</text>
                        </Button>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Estado do sistema -->
            <VBox styleClass="app-sidebar-status" VBox.vgrow="NEVER">
                <Label styleClass="app-status-title" text="STATUS DO SISTEMA"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="app-status-indicator">
                        <Region styleClass="app-status-dot"/>
                    </StackPane>
                    <Label styleClass="app-status-value" text="Operacional"/>
                </HBox>
                <Label styleClass="app-version-text" text="Versão 2.0.0"/>
            </VBox>
        </VBox>
    </left>

    <!-- ===================================================== -->
    <!-- CENTRO — conteúdo                                      -->
    <!-- ===================================================== -->
    <center>
        <StackPane fx:id="contentHost" styleClass="app-content-host">

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="app-content-scroll">
                <content>
                    <VBox fx:id="dashboardContainer"
                          spacing="24"
                          styleClass="app-content, dashboard">

                        <padding>
                            <Insets top="24" right="24" bottom="24" left="24"/>
                        </padding>

                        <!-- Cabeçalho da página -->
                        <VBox spacing="4" styleClass="page-header">
                            <Label text="Dashboard de Gestão de TI"
                                   styleClass="page-title"/>
                            <Label text="Visão geral em tempo real do inventário e operações"
                                   styleClass="page-description"/>
                        </VBox>

                        <!-- ============ KPIs ============ -->
                        <VBox spacing="12" styleClass="page-section">
                            <Label text="Indicadores Principais"
                                   styleClass="page-section-title"/>

                            <FlowPane hgap="16" vgap="16"
                                      styleClass="dashboard-kpi-flow"
                                      prefWrapLength="900">
                                <VBox styleClass="ds-card, ds-stat-card" prefWidth="240">
                                    <Label text="Total Produtos" styleClass="ds-stat-label"/>
                                    <Label fx:id="lblTotalProdutos" text="0" styleClass="ds-stat-value"/>
                                    <Label text="No catálogo" styleClass="ds-stat-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, ds-stat-card" prefWidth="240">
                                    <Label text="Equipamentos Ativos" styleClass="ds-stat-label"/>
                                    <Label fx:id="lblTotalEquipamentos" text="0" styleClass="ds-stat-value"/>
                                    <Label text="Em operação" styleClass="ds-stat-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, ds-stat-card" prefWidth="240">
                                    <Label text="Funcionários Ativos" styleClass="ds-stat-label"/>
                                    <Label fx:id="lblTotalFuncionarios" text="0" styleClass="ds-stat-value"/>
                                    <Label text="Com equipamentos" styleClass="ds-stat-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, ds-stat-card, ds-stat-card--highlight"
                                      prefWidth="240">
                                    <Label text="Valor Total Estoque" styleClass="ds-stat-label"/>
                                    <Label fx:id="lblValorTotalEstoque" text="0 €" styleClass="ds-stat-value"/>
                                    <Label text="Inventário atual" styleClass="ds-stat-description"/>
                                </VBox>
                            </FlowPane>
                        </VBox>

                        <!-- ============ ALERTAS ============ -->
                        <VBox spacing="12" styleClass="page-section">
                            <Label text="Alertas e Indicadores Críticos"
                                   styleClass="page-section-title"/>

                            <FlowPane hgap="16" vgap="16"
                                      styleClass="dashboard-alert-flow"
                                      prefWrapLength="900">

                                <VBox styleClass="ds-card, dashboard-alert-card, dashboard-alert-card--warning"
                                      prefWidth="240">
                                    <Label text="Produto Menor Stock" styleClass="ds-alert-label"/>
                                    <Label fx:id="lblProdutoMenorStock" text="—" styleClass="ds-alert-value"/>
                                    <Label text="Necessita atenção" styleClass="ds-alert-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-alert-card, dashboard-alert-card--danger"
                                      prefWidth="240">
                                    <Label text="Em Manutenção" styleClass="ds-alert-label"/>
                                    <Label fx:id="lblEquipamentosManutencao" text="0" styleClass="ds-alert-value"/>
                                    <Label text="Equipamentos parados" styleClass="ds-alert-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-alert-card, dashboard-alert-card--warning"
                                      prefWidth="240">
                                    <Label text="Toners Baixos" styleClass="ds-alert-label"/>
                                    <Label fx:id="lblTonersBaixos" text="0" styleClass="ds-alert-value"/>
                                    <Label text="Menos de 20% restante" styleClass="ds-alert-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-alert-card, dashboard-alert-card--info"
                                      prefWidth="240">
                                    <Label text="Movimentações Mês" styleClass="ds-alert-label"/>
                                    <Label fx:id="lblMovimentacoesMes" text="0" styleClass="ds-alert-value"/>
                                    <Label text="Atividade atual" styleClass="ds-alert-description"/>
                                </VBox>
                            </FlowPane>
                        </VBox>

                        <!-- ============ MÉTRICAS ============ -->
                        <VBox spacing="12" styleClass="page-section">
                            <Label text="Métricas Avançadas" styleClass="page-section-title"/>

                            <HBox spacing="16">
                                <VBox styleClass="ds-card, ds-stat-card"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Departamento Líder" styleClass="ds-stat-label"/>
                                    <Label fx:id="lblDepartamentoMaiorEquipamentos"
                                           text="—" styleClass="ds-stat-value" wrapText="true"/>
                                    <Label text="Mais equipamentos" styleClass="ds-stat-description"/>
                                </VBox>

                                <VBox styleClass="ds-card, ds-stat-card"
                                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                    <Label text="Nível Stock Segurança" styleClass="ds-stat-label"/>
                                    <ProgressBar fx:id="progressStockSeguranca"
                                                 progress="0"
                                                 maxWidth="Infinity"
                                                 styleClass="ds-progress-bar"/>
                                    <Label text="Produtos com stock disponível"
                                           styleClass="ds-stat-description"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- ============ GRÁFICOS ============ -->
                        <VBox spacing="12" styleClass="page-section">
                            <Label text="Visualizações e Análises" styleClass="page-section-title"/>

                            <GridPane hgap="16" vgap="16" styleClass="dashboard-chart-grid">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="320"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="320"/>
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="ALWAYS" minHeight="300"/>
                                    <RowConstraints vgrow="ALWAYS" minHeight="300"/>
                                </rowConstraints>

                                <VBox styleClass="ds-card, dashboard-chart-container"
                                      GridPane.rowIndex="0" GridPane.columnIndex="0">
                                    <Label text="Movimentações por Tipo" styleClass="ds-card-title"/>
                                    <BarChart fx:id="chartMovimentacoes"
                                              legendVisible="false"
                                              styleClass="dashboard-chart"
                                              VBox.vgrow="ALWAYS">
                                        <xAxis><CategoryAxis label="Tipo"/></xAxis>
                                        <yAxis><NumberAxis label="Quantidade"/></yAxis>
                                    </BarChart>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-chart-container"
                                      GridPane.rowIndex="0" GridPane.columnIndex="1">
                                    <Label text="Distribuição por Tipo" styleClass="ds-card-title"/>
                                    <PieChart fx:id="chartDistribuicaoTipos"
                                              styleClass="dashboard-chart"
                                              VBox.vgrow="ALWAYS"/>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-chart-container"
                                      GridPane.rowIndex="1" GridPane.columnIndex="0">
                                    <Label text="Tendência de Estoque" styleClass="ds-card-title"/>
                                    <LineChart fx:id="chartTrendEstoque"
                                               styleClass="dashboard-chart"
                                               VBox.vgrow="ALWAYS">
                                        <xAxis><CategoryAxis label="Mês"/></xAxis>
                                        <yAxis><NumberAxis label="Movimentações"/></yAxis>
                                    </LineChart>
                                </VBox>

                                <VBox styleClass="ds-card, dashboard-chart-container"
                                      GridPane.rowIndex="1" GridPane.columnIndex="1">
                                    <Label text="Equipamentos por Departamento" styleClass="ds-card-title"/>
                                    <BarChart fx:id="chartEquipamentosDepartamento"
                                              legendVisible="false"
                                              styleClass="dashboard-chart"
                                              VBox.vgrow="ALWAYS">
                                        <xAxis><CategoryAxis label="Departamento"/></xAxis>
                                        <yAxis><NumberAxis label="Equipamentos"/></yAxis>
                                    </BarChart>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- ============ RODAPÉ ============ -->
                        <HBox alignment="CENTER_RIGHT" spacing="6" styleClass="dashboard-footer">
                            <Label text="Última atualização:" styleClass="ds-caption"/>
                            <Label fx:id="lblUltimaAtualizacao" styleClass="ds-caption" text="—"/>
                        </HBox>

                    </VBox>
                </content>
            </ScrollPane>

            <!-- Host para painéis dinâmicos (detalhes, formulários) -->
            <StackPane fx:id="overlayHost" styleClass="app-overlay-host"/>

        </StackPane>
    </center>

    <!-- ===================================================== -->
    <!-- ASIDE (painel direito — opcional)                      -->
    <!-- ===================================================== -->
    <right>
        <StackPane fx:id="asideHost"
                   prefWidth="0"
                   minWidth="0"
                   styleClass="app-aside"
                   BorderPane.alignment="CENTER">
            <!-- Preenchido em runtime pelo controller quando necessário -->
        </StackPane>
    </right>

    <!-- ===================================================== -->
    <!-- FOOTER (opcional)                                      -->
    <!-- ===================================================== -->
    <bottom>
        <HBox alignment="CENTER" styleClass="app-footer">
            <Label fx:id="lblFooter"
                   styleClass="app-footer-text"
                   text="© 2024 Gestão de Equipamentos de TI — Todos os direitos reservados"/>
        </HBox>
    </bottom>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="750.0" prefWidth="1100.0"
            styleClass="historico-detail-root">

    <!-- ========== TOP: HEADER ========== -->
    <top>
        <VBox spacing="0" styleClass="historico-detail-header-container">
            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="historico-detail-header-bar">
                <padding>
                    <Insets bottom="15" left="20" right="20" top="15" />
                </padding>
                <Button fx:id="btn_voltar" text="← Voltar" styleClass="btn-secondary" />
                <VBox spacing="3">
                    <Label fx:id="tituloLabel" text="Detalhes do Evento"
                           styleClass="historico-detail-title" />
                    <Label fx:id="subtituloLabel" text="Tipo: - | -"
                           styleClass="historico-detail-subtitle" />
                    <Label fx:id="subtituloDeviceLabel" text="Dispositivo: -"
                           styleClass="historico-detail-device" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btn_imprimir" text="Imprimir" styleClass="btn-secondary" />
                <Button fx:id="btn_exportar" text="Exportar JSON" styleClass="btn-primary" />
            </HBox>

            <HBox spacing="20" styleClass="historico-detail-status-row">
                <padding>
                    <Insets bottom="8" left="20" right="20" top="0" />
                </padding>
                <Label fx:id="mensagemStatusLabel" text="" styleClass="historico-detail-status-message" />
            </HBox>
        </VBox>
    </top>

    <!-- ========== CENTER ========== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="historico-detail-scroll">
            <VBox spacing="20" styleClass="historico-detail-content">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <!-- ===== LINHA 1: CARDS CONTEXTO ===== -->
                <HBox spacing="15">
                    <VBox spacing="8" styleClass="detail-card" HBox.hgrow="ALWAYS">
                        <Label text="SKU" styleClass="detail-card-header" />
                        <Label fx:id="cardSku" text="-" styleClass="detail-value-strong" />
                    </VBox>

                    <VBox spacing="8" styleClass="detail-card" HBox.hgrow="ALWAYS">
                        <Label text="Responsável" styleClass="detail-card-header" />
                        <Label fx:id="cardFuncionarioId" text="-" styleClass="detail-value-strong" />
                        <Label fx:id="cardFuncionarioNome" text="-" styleClass="detail-value-muted" />
                        <Label fx:id="cardFuncionarioEmail" text="-" styleClass="detail-value-muted" />
                    </VBox>

                    <VBox spacing="8" styleClass="detail-card" HBox.hgrow="ALWAYS">
                        <Label text="Resumo das Alterações" styleClass="detail-card-header" />
                        <Label fx:id="cardResumo" text="-" styleClass="detail-value-strong" />
                    </VBox>
                </HBox>

                <!-- ===== LINHA 2: DESCRIÇÃO ===== -->
                <VBox spacing="8" styleClass="detail-card">
                    <Label text="Descrição do Evento" styleClass="detail-card-header" />
                    <Label fx:id="descricaoEvento" text="-" wrapText="true"
                           styleClass="detail-value" />
                </VBox>

                <!-- ===== LINHA 3: SNAPSHOTS LADO A LADO ===== -->
                <HBox spacing="15" VBox.vgrow="ALWAYS">

                    <VBox spacing="8" styleClass="detail-card" HBox.hgrow="ALWAYS">
                        <Label text="Dados Anteriores" styleClass="detail-card-header-antes" />
                        <TextArea fx:id="areaAnteriores" editable="false" wrapText="false"
                                  prefRowCount="18" styleClass="historico-json-area-antes" />
                    </VBox>

                    <VBox spacing="8" styleClass="detail-card" HBox.hgrow="ALWAYS">
                        <Label text="Dados Novos" styleClass="detail-card-header-depois" />
                        <TextArea fx:id="areaNovos" editable="false" wrapText="false"
                                  prefRowCount="18" styleClass="historico-json-area-depois" />
                    </VBox>
                </HBox>

                <!-- ===== LINHA 4: DIFERENÇAS ===== -->
                <VBox spacing="8" styleClass="detail-card">
                    <Label fx:id="lblDiferencasTitulo" text="Diferenças"
                           styleClass="detail-card-header" />
                    <ListView fx:id="listaDiferencas" prefHeight="160"
                              styleClass="historico-diferencas-lista" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ========== BOTTOM ========== -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="historico-detail-bottom-bar">
            <padding>
                <Insets bottom="12" left="20" right="20" top="12" />
            </padding>
            <Button fx:id="btn_verOutrosSku" text="Ver outros deste SKU" styleClass="btn-secondary" />
            <Button fx:id="btn_verOutrosFuncionario" text="Ver outros deste funcionário" styleClass="btn-secondary" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_copiarJson" text="Copiar JSON" styleClass="btn-secondary" />
            <Button fx:id="btn_fechar" text="Fechar" styleClass="btn-danger" />
        </HBox>
    </bottom>
</BorderPane>
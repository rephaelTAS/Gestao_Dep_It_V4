<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="800.0" prefWidth="1200.0"
            styleClass="historico-list-root">

    <VBox spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ========== HEADER ========== -->
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="list-header">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label text="Histórico de Eventos" styleClass="list-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_relatorio" text="Relatório" styleClass="btn-secondary" />
            <Button fx:id="btn_exportar" text="Exportar CSV" styleClass="btn-primary" />
        </HBox>

        <!-- ========== SUBTÍTULO / ESTATÍSTICAS ========== -->
        <VBox spacing="5" styleClass="historico-list-sub-header">
            <padding>
                <Insets bottom="10" left="20" right="20" top="5" />
            </padding>
            <Label text="Auditoria completa de todas as ações do sistema"
                   styleClass="historico-list-subtitle" />
            <HBox spacing="30">
                <Label fx:id="estatisticasLabel" text="Carregando estatísticas..."
                       styleClass="list-statistics" />
                <Label fx:id="filtrosAtivosLabel" text="" styleClass="list-active-filters" />
            </HBox>
        </VBox>

        <!-- ========== FILTROS ========== -->
        <VBox spacing="12" styleClass="list-card">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label text="Filtros" styleClass="list-card-header" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="filtroPesquisa"
                           promptText="Pesquisar por SKU, funcionário ou descrição..."
                           HBox.hgrow="ALWAYS" prefWidth="350" />
                <ComboBox fx:id="filtroTipoEvento" promptText="Tipo de evento" prefWidth="160" />
                <DatePicker fx:id="filtroDataInicio" promptText="De" prefWidth="140" />
                <Label text="até" styleClass="filter-separator" />
                <DatePicker fx:id="filtroDataFim" promptText="Até" prefWidth="140" />
                <Button fx:id="btn_limparFiltros" text="Limpar" styleClass="btn-secondary" />
                <Button fx:id="btn_aplicarFiltros" text="Buscar" styleClass="btn-primary"
                        defaultButton="true" />
            </HBox>
        </VBox>

        <!-- ========== TABELA ========== -->
        <VBox VBox.vgrow="ALWAYS" styleClass="historico-list-table-container">
            <padding>
                <Insets left="20" right="20" top="10" />
            </padding>
            <TableView fx:id="eventosTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colDataHora" text="Data/Hora" prefWidth="160" />
                    <TableColumn fx:id="colTipoEvento" text="Tipo" prefWidth="130" />
                    <TableColumn fx:id="colSkuProduto" text="SKU" prefWidth="130" />
                    <TableColumn fx:id="colFuncionario" text="Funcionário" prefWidth="150" />
                    <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="450" />
                    <TableColumn fx:id="colAcoes" text="Ações" prefWidth="80" />
                </columns>
            </TableView>

            <!-- Paginação -->
            <HBox spacing="10" alignment="CENTER" styleClass="pagination-bar">
                <Button fx:id="btn_primeira" text="⏮" styleClass="btn-pagination" />
                <Button fx:id="btn_anterior" text="◀" styleClass="btn-pagination" />
                <Label fx:id="labelPagina" text="Página 1 de 1" styleClass="pagination-label" />
                <Button fx:id="btn_proxima" text="▶" styleClass="btn-pagination" />
                <Button fx:id="btn_ultima" text="⏭" styleClass="btn-pagination" />
                <Label text="Itens por página:" styleClass="pagination-label" />
                <ComboBox fx:id="comboItensPorPagina" prefWidth="80" />
            </HBox>
        </VBox>

        <!-- ========== STATUS BAR ========== -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
            <Label fx:id="statusLabel" text="Pronto" styleClass="status-text" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btn_atualizar" text="Atualizar" styleClass="btn-secondary" />
            <Button fx:id="btn_fechar" text="Fechar" styleClass="btn-danger" />
            <ProgressIndicator fx:id="progressIndicator" visible="false" />
        </HBox>
    </VBox>
</AnchorPane>
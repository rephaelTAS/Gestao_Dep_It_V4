<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="detail-root">

    <!-- ===== TOP: HEADER ===== -->
    <top>
        <VBox spacing="0">
            <!-- Barra superior -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="detail-header-bar">

                <!-- Ícone e Título -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <ImageView fx:id="imgEquipamentoIcon" fitHeight="32" fitWidth="32" preserveRatio="true" />
                    <VBox spacing="2">
                        <Label fx:id="lblTituloEquipamento" text="Detalhes do Equipamento" styleClass="detail-title" />
                        <Label fx:id="lblSubtitulo" text="Visualização completa de dados integrados" styleClass="detail-subtitle" />
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Badge de Status -->
                <HBox alignment="CENTER" spacing="10">
                    <Label fx:id="lblStatusBadge" text="" styleClass="badge-status" />
                    <Label fx:id="lblCondicaoBadge" text="" styleClass="badge-condicao" />
                </HBox>

                <!-- Botões de Ação -->
                <HBox spacing="10">
                    <Button fx:id="btn_editar" text="📝 Editar" styleClass="btn-primary" />
                    <Button fx:id="btn_historico" text="📊 Histórico" styleClass="btn-secondary" />
                    <Button fx:id="btn_relatorio" text="🖨️ Relatório" styleClass="btn-secondary" />
                    <Button fx:id="btn_excluir" text="🗑️ Excluir" styleClass="btn-danger" />
                    <Button fx:id="btn_fechar" text="✕ Fechar" styleClass="btn-secondary" />
                </HBox>
            </HBox>

            <!-- Barra de informações rápidas -->
            <HBox alignment="CENTER_LEFT" spacing="30" styleClass="detail-info-bar">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="🕐 Tempo de Uso:" styleClass="info-label" />
                    <Label fx:id="lblTempoUso" text="Carregando..." styleClass="info-value" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📅 Próxima Verificação:" styleClass="info-label" />
                    <Label fx:id="lblProximaVerificacao" text="Carregando..." styleClass="info-value" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="📈 Performance:" styleClass="info-label" />
                    <ProgressBar fx:id="pbPerformance" prefWidth="150" progress="0" />
                    <Label fx:id="lblPerformancePercent" text="0%" styleClass="info-value" />
                </HBox>
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTER: CONTEÚDO ===== -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="detail-scroll">
            <VBox spacing="20" styleClass="detail-content">

                <!-- ===== LINHA 1: CARDS ===== -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <!-- CARD 1: IDENTIFICAÇÃO -->
                    <VBox spacing="15" styleClass="detail-card" prefWidth="280">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-primary">
                            <Label text="🔍" styleClass="card-icon" />
                            <Label text="IDENTIFICAÇÃO" styleClass="card-header-title" />
                        </HBox>
                        <VBox spacing="12" styleClass="card-content">
                            <GridPane hgap="10" vgap="10">
                                <Label text="Nº Série:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblNumSerie" styleClass="value-highlight" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Endereço MAC:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblEnderecoMac" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="SKU Catálogo:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblSku" styleClass="value-highlight" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Tipo:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="lblTipoEquipamento" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </GridPane>
                        </VBox>
                    </VBox>

                    <!-- CARD 2: LOCALIZAÇÃO -->
                    <VBox spacing="15" styleClass="detail-card" prefWidth="280">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-secondary">
                            <Label text="📍" styleClass="card-icon" />
                            <Label text="LOCALIZAÇÃO" styleClass="card-header-title" />
                        </HBox>
                        <VBox spacing="12" styleClass="card-content">
                            <GridPane hgap="10" vgap="10">
                                <Label text="Departamento:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblDepartamento" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Sala/Local:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblLocalizacao" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Funcionário ID:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblFuncionarioId" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Nome Funcionário:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="lblFuncionarioNome" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Função:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="lblFuncao" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            </GridPane>
                        </VBox>
                    </VBox>

                    <!-- CARD 3: STATUS -->
                    <VBox spacing="15" styleClass="detail-card" prefWidth="280">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-success">
                            <Label text="📊" styleClass="card-icon" />
                            <Label text="STATUS &amp; CONDIÇÃO" styleClass="card-header-title" />
                        </HBox>
                        <VBox alignment="CENTER" spacing="15" styleClass="card-content">
                            <StackPane>
                                <Circle fill="transparent" radius="60" stroke="#e5e7eb" strokeWidth="10" />
                                <Arc fx:id="arcStatusProgress" centerX="60" centerY="60" fill="transparent"
                                     length="0" radiusX="60" radiusY="60" startAngle="90"
                                     stroke="#10b981" strokeLineCap="ROUND" strokeWidth="10" />
                                <VBox alignment="CENTER" spacing="2">
                                    <Label fx:id="lblStatusScore" text="0%" styleClass="score-label" />
                                    <Label text="Saúde" styleClass="score-subtitle" />
                                </VBox>
                            </StackPane>

                            <GridPane hgap="10" vgap="8">
                                <Label text="Status Atual:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblStatus" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Condição:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblCondicao" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Última Verif.:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblUltimaVerificacao" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Devolução:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="lblDevolucao" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                            </GridPane>
                        </VBox>
                    </VBox>

                    <!-- CARD 4: AÇÕES RÁPIDAS -->
                    <VBox spacing="15" styleClass="detail-card" prefWidth="220">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-purple">
                            <Label text="⚡" styleClass="card-icon" />
                            <Label text="AÇÕES RÁPIDAS" styleClass="card-header-title" />
                        </HBox>
                        <VBox spacing="10" styleClass="card-content">
                            <Button fx:id="btn_verificacao" text="🔄 Registrar Verificação" styleClass="btn-action-info" />
                            <Button fx:id="btn_manutencao" text="🔧 Enviar p/ Manutenção" styleClass="btn-action-danger" />
                            <Button fx:id="btn_qrCode" text="📋 Gerar QR Code" styleClass="btn-action-success" />
                            <Button fx:id="btn_anexar" text="📎 Anexar Documento" styleClass="btn-action-purple" />
                            <Separator />
                            <Button fx:id="btn_baixar" text="🗑️ Baixar Equipamento" styleClass="btn-action-gray" />
                        </VBox>
                    </VBox>
                </HBox>

                <!-- ===== LINHA 2: DETALHES TÉCNICOS ===== -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <!-- CARD 5: DADOS TÉCNICOS -->
                    <VBox spacing="15" styleClass="detail-card" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-warning">
                            <Label text="⚙️" styleClass="card-icon" />
                            <Label text="DADOS TÉCNICOS" styleClass="card-header-title" />
                        </HBox>
                        <VBox spacing="15" styleClass="card-content">
                            <GridPane hgap="15" vgap="12">
                                <Label text="Marca:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <Label fx:id="lblMarca" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Modelo:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <Label fx:id="lblModelo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Cor:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <Label fx:id="lblCor" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Categoria:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <Label fx:id="lblCategoria" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Preço Unitário:" styleClass="label-bold" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <Label fx:id="lblPrecoUnitario" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label text="Data Aquisição:" styleClass="label-bold" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <Label fx:id="lblDataAquisicao" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                                <Label text="Data Instalação:" styleClass="label-bold" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                                <Label fx:id="lblDataInstalacao" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                                <Label text="Nº Fatura:" styleClass="label-bold" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                <Label fx:id="lblNumeroFatura" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                                <Label text="Criado em:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <Label fx:id="lblCreatedAt" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Atualizado em:" styleClass="label-bold" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <Label fx:id="lblUpdatedAt" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </GridPane>

                            <VBox spacing="10" styleClass="detail-tech-box">
                                <Label text="📋 Características Técnicas:" styleClass="label-bold" />
                                <TextArea fx:id="txtCaracteristicasTecnicas" editable="false" prefRowCount="4" wrapText="true" styleClass="detail-textarea" />
                            </VBox>

                            <VBox spacing="10" styleClass="detail-tech-box">
                                <Label text="📝 Descrição:" styleClass="label-bold" />
                                <TextArea fx:id="txtDescricao" editable="false" prefRowCount="3" wrapText="true" styleClass="detail-textarea" />
                            </VBox>

                            <VBox spacing="10" styleClass="detail-tech-box">
                                <Label text="📝 Observações:" styleClass="label-bold" />
                                <TextArea fx:id="txtObservacoes" editable="false" prefRowCount="2" wrapText="true" styleClass="detail-textarea" />
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- CARD 6: HISTÓRICO -->
                    <VBox spacing="15" styleClass="detail-card" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="detail-card-header-pink">
                            <Label text="📅" styleClass="card-icon" />
                            <Label text="HISTÓRICO" styleClass="card-header-title" />
                        </HBox>
                        <TabPane styleClass="detail-tab-pane" tabClosingPolicy="UNAVAILABLE">
                            <Tab text="✅ Verificações">
                                <ScrollPane fitToWidth="true" styleClass="detail-scroll">
                                    <VBox spacing="10" styleClass="tab-content">
                                        <ListView fx:id="listVerificacoes" styleClass="list-view" />
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                            <Tab text="🔧 Manutenções">
                                <ScrollPane fitToWidth="true" styleClass="detail-scroll">
                                    <VBox spacing="10" styleClass="tab-content">
                                        <ListView fx:id="listManutencoes" styleClass="list-view" />
                                    </VBox>
                                </ScrollPane>
                            </Tab>
                        </TabPane>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- ===== BOTTOM ===== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="30" styleClass="detail-bottom-bar">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🔄 Última Atualização:" styleClass="bottom-label" />
                <Label fx:id="lblUltimaAtualizacao" text="Carregando..." styleClass="bottom-value" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10">
                <Label text="📊 ID Registro:" styleClass="bottom-label" />
                <Label fx:id="lblIdRegistro" text="#INV-00000" styleClass="bottom-value-highlight" />
                <Label text="ID Banco:" styleClass="bottom-label" />
                <Label fx:id="lblIdBanco" text="#0" styleClass="bottom-value-highlight" />
            </HBox>
        </HBox>
    </bottom>
</BorderPane>
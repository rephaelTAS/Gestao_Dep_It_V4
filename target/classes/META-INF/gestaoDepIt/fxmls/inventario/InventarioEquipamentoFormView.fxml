<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="750" prefWidth="950">

    <!-- Cabeçalho -->
    <VBox fx:id="headerContainer" spacing="12" styleClass="form-header"
          AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">
        <padding>
            <Insets bottom="20" left="30" right="30" top="25" />
        </padding>

        <Label fx:id="labelTitulo" text="Novo Equipamento no Inventário"
               styleClass="form-title" />
        <Label text="Cadastro completo de equipamento no sistema de inventário"
               styleClass="form-subtitle" />
    </VBox>

    <!-- Conteúdo com Scroll -->
    <ScrollPane fitToWidth="true" styleClass="form-scroll"
                vbarPolicy="AS_NEEDED"
                AnchorPane.bottomAnchor="100" AnchorPane.leftAnchor="20"
                AnchorPane.rightAnchor="20" AnchorPane.topAnchor="120">

        <VBox spacing="25" styleClass="form-content">
            <padding>
                <Insets bottom="20" left="10" right="10" top="0" />
            </padding>

            <!-- Seção 1: Identificação -->
            <VBox styleClass="form-section">
                <Label text="Identificação do Equipamento" styleClass="section-title" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                    </columnConstraints>

                    <Label text="Produto do Catálogo *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox fx:id="comboCatalogo" promptText="Selecione um produto..."
                              GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="0" />

                    <Label text="Número de Série *" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="txtNumSerie" editable="false"
                                   promptText="Gerado pelo sistema" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnGerarNumSerie" text="Gerar"
                                styleClass="btn-secondary" />
                    </HBox>

                    <Label text="Endereço MAC" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="txtEnderecoMac" promptText="Ex: 00:1A:2B:3C:4D:5E (opcional)"
                               GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <Label text="Data Aquisição (do produto)" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <DatePicker fx:id="dateAquisicao" promptText="derivada do produto"
                                GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Data Instalação" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <DatePicker fx:id="dateInstalacao" promptText="dd/mm/aaaa (opcional)"
                                GridPane.columnIndex="3" GridPane.rowIndex="2" />
                </GridPane>
            </VBox>

            <!-- Seção 2: Localização -->
            <VBox styleClass="form-section">
                <Label text="Localização e Responsável" styleClass="section-title" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                    </columnConstraints>

                    <Label text="Funcionário Responsável" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox fx:id="comboFuncionario" promptText="Selecione um funcionário (opcional)"
                              GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="0" />

                    <Label text="Localização" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtLocalizacao" promptText="Ex: Sala 301, Prédio A (opcional)"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Departamento" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="txtDepartamento" promptText="Ex: TI, Administração (opcional)"
                               GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>

            <!-- Seção 3: Status -->
            <VBox styleClass="form-section">
                <Label text="Status e Condição" styleClass="section-title" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                    </columnConstraints>

                    <Label text="Status *" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <ComboBox fx:id="comboStatus" promptText="Selecione o status"
                              GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Condição *" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <ComboBox fx:id="comboCondicao" promptText="Selecione a condição"
                              GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label text="Última Verificação" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <DatePicker fx:id="dateUltimaVerificacao" promptText="dd/mm/aaaa (opcional)"
                                GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Devolução" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <CheckBox fx:id="chkDevolucao" text="Equipamento devolvido"
                              GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>

            <!-- Seção 4: Documentos administrativos -->
            <VBox styleClass="form-section">
                <Label text="Documentos" styleClass="section-title" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                    </columnConstraints>

                    <Label text="Nº Fatura" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtNumeroFatura" promptText="Número da fatura (opcional)"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Observações" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="txtObservacoes" promptText="Observações sobre o equipamento (opcional)"
                               GridPane.columnIndex="3" GridPane.rowIndex="0" />
                </GridPane>
            </VBox>

            <!-- Seção 5: Termo de Entrega -->
            <VBox fx:id="secaoDocEntrega" styleClass="form-section">
                <Label text="Termo de Entrega" styleClass="section-title" />
                <Label text="Gere o PDF, colha a assinatura do responsável e selecione o arquivo assinado."
                       styleClass="form-subtitle" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnGerarEntrega" text="Gerar termo" styleClass="btn-secondary" />
                    <Button fx:id="btnSelecionarEntrega" text="Selecionar assinado" styleClass="btn-primary" />
                    <Button fx:id="btnLimparEntrega" text="Limpar" styleClass="btn-secondary" />
                </HBox>
                <Label fx:id="lblStatusEntrega" text="Nenhum documento anexado."
                       styleClass="form-hint" />
            </VBox>

            <!-- Seção 6: Termo de Devolução (condicional a chkDevolucao) -->
            <VBox fx:id="secaoDocDevolucao" styleClass="form-section"
                  visible="false" managed="false">
                <Label text="Termo de Devolução" styleClass="section-title" />
                <Label text="Gere o PDF, colha a assinatura do responsável e selecione o arquivo assinado."
                       styleClass="form-subtitle" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnGerarDevolucao" text="Gerar termo" styleClass="btn-secondary" />
                    <Button fx:id="btnSelecionarDevolucao" text="Selecionar assinado" styleClass="btn-primary" />
                    <Button fx:id="btnLimparDevolucao" text="Limpar" styleClass="btn-secondary" />
                </HBox>
                <Label fx:id="lblStatusDevolucao" text="Nenhum documento anexado."
                       styleClass="form-hint" />
            </VBox>

            <!-- Seção 7: Informações do Sistema (apenas edição) -->
            <VBox fx:id="sistemaInfoSection" styleClass="form-section" visible="false" managed="false">
                <Label text="Informações do Sistema" styleClass="section-title" />
                <GridPane hgap="20" vgap="18">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                        <ColumnConstraints halignment="RIGHT" prefWidth="200" />
                        <ColumnConstraints prefWidth="280" />
                    </columnConstraints>

                    <Label text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="txtId" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Criado em" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="txtCreatedAt" editable="false"
                               GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label text="Atualizado em" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="txtUpdatedAt" editable="false"
                               GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Rodapé -->
    <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="form-footer"
          AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0">
        <padding>
            <Insets bottom="15" left="30" right="30" top="15" />
        </padding>
        <Label text="* Campos obrigatórios" styleClass="form-hint" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btn_cancelar" text="Cancelar" styleClass="btn-secondary" />
        <Button fx:id="btn_salvar" text="Salvar Equipamento" styleClass="btn-primary" defaultButton="true" />
    </HBox>
</AnchorPane>
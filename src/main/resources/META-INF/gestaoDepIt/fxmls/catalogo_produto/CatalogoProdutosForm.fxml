<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!--
    FormProduto.fxml v1.1
    Formulário de cadastro/edição de produto.
    Estilização em formproduto.css.
-->
<AnchorPane prefHeight="750.0" prefWidth="800.0"
            styleClass="formproduto-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                styleClass="formproduto-scroll"
                AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox spacing="24" styleClass="formproduto-container">

            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>

            <!-- ==================== HEADER ==================== -->
            <Label fx:id="tituloLabel" text="Novo Produto no Catálogo"
                   styleClass="formproduto-title"/>

            <!-- ==================== SKU GERADO ==================== -->
            <VBox fx:id="idGeradoContainer" spacing="4"
                  visible="false" managed="false"
                  styleClass="formproduto-sku-box">
                <Label fx:id="idGeradoLabel" text="SKU gerado: "
                       styleClass="formproduto-sku-value"/>
                <Label text="SKU gerado automaticamente baseado em Tipo, Marca e Modelo"
                       styleClass="formproduto-hint"/>
            </VBox>

            <!-- ==================== FORMULÁRIO ==================== -->
            <VBox spacing="6" styleClass="formproduto-section">
                <Label text="Informações do Produto"
                       styleClass="formproduto-section-title"/>

                <GridPane hgap="15" vgap="14" styleClass="formproduto-grid">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="160" prefWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <!-- SKU (readonly) -->
                    <Label text="SKU *" styleClass="formproduto-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="skuField"
                               promptText="Será gerado automaticamente"
                               editable="false"
                               styleClass="clay-input formproduto-readonly"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Tipo -->
                    <Label text="Tipo de Produto *" styleClass="formproduto-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="tipoProduto" promptText="Selecione o tipo"
                              maxWidth="Infinity"
                              styleClass="clay-input"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Categoria -->
                    <Label text="Categoria *" styleClass="formproduto-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="categoriaField"
                               promptText="Ex: Impressora, Toner, Monitor"
                               styleClass="clay-input"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Marca -->
                    <Label text="Marca *" styleClass="formproduto-label"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="marcaField"
                               promptText="Fabricante do produto"
                               styleClass="clay-input"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Modelo -->
                    <Label text="Modelo *" styleClass="formproduto-label"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="modeloField"
                               promptText="Modelo específico"
                               styleClass="clay-input"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Cor -->
                    <Label text="Cor" styleClass="formproduto-label"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="corField"
                               promptText="Cor do produto (opcional)"
                               styleClass="clay-input"
                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- Fornecedor -->
                    <Label text="Fornecedor" styleClass="formproduto-label"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextField fx:id="fornecedorField"
                               promptText="Fornecedor do produto"
                               styleClass="clay-input"
                               GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <!-- Nº Fatura -->
                    <Label text="Nº Fatura" styleClass="formproduto-label"
                           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <TextField fx:id="numeroFaturaField"
                               promptText="Número da fatura"
                               styleClass="clay-input"
                               GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <!-- Anexo Fatura -->
                    <Label text="Anexo da Fatura" styleClass="formproduto-label"
                           GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <VBox spacing="6" GridPane.rowIndex="8" GridPane.columnIndex="1">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button fx:id="btn_anexarFatura" text="📎 Anexar PDF/Imagem"
                                    styleClass="clay-button clay-button-soft"/>
                            <Button fx:id="btn_removerFatura" text="🗑 Remover"
                                    styleClass="clay-button clay-button-danger-outline"/>
                            <Label fx:id="lblFaturaSelecionada"
                                   text="Nenhum arquivo anexado"
                                   styleClass="formproduto-hint"/>
                        </HBox>
                        <Label text="PDF ou imagem até 2MB (opcional)"
                               styleClass="formproduto-hint"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- ==================== VALORES ==================== -->
            <VBox spacing="6" styleClass="formproduto-section">
                <Label text="Preços e Estoque"
                       styleClass="formproduto-section-title"/>

                <GridPane hgap="15" vgap="14" styleClass="formproduto-grid">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="160" prefWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <!-- Preço -->
                    <Label text="Preço Unitário *" styleClass="formproduto-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <HBox spacing="8" alignment="CENTER_LEFT"
                          GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <TextField fx:id="precoUnitarioField" promptText="0.00"
                                   styleClass="clay-input"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="€" styleClass="formproduto-symbol"/>
                    </HBox>

                    <!-- IVA -->
                    <Label text="IVA (%)" styleClass="formproduto-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="8" alignment="CENTER_LEFT"
                          GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextField fx:id="ivaField" promptText="23"
                                   styleClass="clay-input"
                                   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Label text="%" styleClass="formproduto-symbol"/>
                    </HBox>

                    <!-- Estoque -->
                    <Label text="Estoque Inicial" styleClass="formproduto-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="totalRecebidoField" promptText="0"
                               styleClass="clay-input"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- ==================== DESCRIÇÃO ==================== -->
            <VBox spacing="6" styleClass="formproduto-section">
                <Label text="Descrição e Características"
                       styleClass="formproduto-section-title"/>

                <GridPane hgap="15" vgap="14" styleClass="formproduto-grid">
                    <columnConstraints>
                        <ColumnConstraints hgrow="NEVER" minWidth="160" prefWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250"/>
                    </columnConstraints>

                    <Label text="Descrição" styleClass="formproduto-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextArea fx:id="descricaoField"
                              promptText="Descrição detalhada do produto"
                              wrapText="true" prefRowCount="3"
                              styleClass="clay-textarea"
                              GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Características Técnicas" styleClass="formproduto-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <TextArea fx:id="caracteristicasField"
                                  promptText='JSON com características técnicas&#10;Ex: {"peso": "2.5kg", "dimensoes": "30x20x15cm"}'
                                  wrapText="true" prefRowCount="4"
                                  styleClass="clay-textarea"/>
                        <Label text='Formato JSON: {"chave": "valor"}'
                               styleClass="formproduto-hint"/>
                    </VBox>

                    <Label text="Status" styleClass="formproduto-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="ativoCheckBox" text="Produto Ativo" selected="true"
                              styleClass="clay-checkbox"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>
            </VBox>

            <!-- ==================== PREVIEW ==================== -->
            <VBox spacing="8" styleClass="formproduto-preview-box">
                <Label text="Preview do Produto"
                       styleClass="formproduto-preview-title"/>
                <Label fx:id="previewLabel"
                       text="SKU: - | Tipo: - | Marca: - | Modelo: - | Preço: - | Estoque: -"
                       styleClass="formproduto-preview-text"
                       wrapText="true"/>
            </VBox>

            <!-- ==================== ERRO ==================== -->
            <Label fx:id="mensagemErroLabel" visible="false" managed="false"
                   maxWidth="Infinity"
                   styleClass="formproduto-error"
                   wrapText="true"/>

            <!-- ==================== BOTÕES ==================== -->
            <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="formproduto-button-bar">
                <Button fx:id="btn_cancelar" text="Cancelar"
                        styleClass="clay-button clay-button-ghost"/>
                <Button fx:id="btn_salvar" text="💾 Salvar Produto"
                        styleClass="clay-button clay-button-primary elevation-2"/>
            </HBox>

        </VBox>
    </ScrollPane>
</AnchorPane>
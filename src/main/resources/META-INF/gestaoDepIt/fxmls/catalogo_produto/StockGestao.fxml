<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!--
    DashboardAnalitico.fxml v1.1
    Dashboard com KPIs, gráficos e tabelas analíticas.
    Estilização em dashboard.css.
-->
<ScrollPane fitToWidth="true" vbarPolicy="ALWAYS"
            styleClass="dash-scroll"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1">

    <VBox spacing="12" styleClass="dash-container">
        <padding><Insets top="12" right="12" bottom="15" left="12"/></padding>

        <!-- ==================== HEADER ==================== -->
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="dash-header">
            <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>
            <Label text="📊 Gestão Inteligente de Ativos" styleClass="dash-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btn_atualizar" text="⟳ Atualizar Análises"
                    styleClass="clay-button clay-button-soft"/>
            <Button fx:id="btn_exportarRelatorio" text="📄 Exportar Relatório"
                    styleClass="clay-button clay-button-primary elevation-1"/>
        </HBox>

        <!-- ==================== FILTROS ==================== -->
        <VBox spacing="10" styleClass="dash-card">
            <Label text="Filtros de Análise" styleClass="dash-card-header"/>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" hgrow="NEVER"/>
                    <ColumnConstraints minWidth="160" hgrow="ALWAYS" percentWidth="16"/>
                    <ColumnConstraints minWidth="100" hgrow="NEVER"/>
                    <ColumnConstraints minWidth="160" hgrow="ALWAYS" percentWidth="16"/>
                    <ColumnConstraints minWidth="110" hgrow="NEVER"/>
                    <ColumnConstraints minWidth="160" hgrow="ALWAYS" percentWidth="20"/>
                </columnConstraints>

                <Label text="Tipo de Produto:" styleClass="dash-filter-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbTipoProduto" maxWidth="Infinity"
                          styleClass="clay-input-compact"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Status:" styleClass="dash-filter-label"
                       GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbStatus" maxWidth="Infinity"
                          styleClass="clay-input-compact"
                          GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Localização:" styleClass="dash-filter-label"
                       GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cbLocalizacao" maxWidth="Infinity"
                          styleClass="clay-input-compact"
                          GridPane.columnIndex="5" GridPane.rowIndex="0"/>

                <Label text="Condição:" styleClass="dash-filter-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbCondicao" maxWidth="Infinity"
                          styleClass="clay-input-compact"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Departamento:" styleClass="dash-filter-label"
                       GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbDepartamento" maxWidth="Infinity"
                          styleClass="clay-input-compact"
                          GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <HBox spacing="10" alignment="CENTER_RIGHT"
                      GridPane.columnIndex="4" GridPane.rowIndex="1"
                      GridPane.columnSpan="2">
                    <CheckBox fx:id="ckApenasDefeito" text="Apenas com Defeito"
                              styleClass="clay-checkbox"/>
                    <Button fx:id="btn_aplicarFiltros" text="Aplicar Filtros"
                            styleClass="clay-button clay-button-primary"/>
                    <Button fx:id="btn_limparFiltros" text="Limpar"
                            styleClass="clay-button clay-button-ghost"/>
                </HBox>
            </GridPane>
        </VBox>

        <!-- ==================== GAUGES ==================== -->
        <HBox spacing="12" styleClass="dash-gauges-row">
            <VBox spacing="6" styleClass="dash-gauge-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Saúde Geral" styleClass="dash-gauge-title"/>
                <Label fx:id="gaugeSaudeGeral" text="--" styleClass="dash-gauge-value dash-gauge-green"/>
                <ProgressBar fx:id="barSaudeGeral" progress="0.0"
                             maxWidth="Infinity" styleClass="dash-gauge-progress"/>
                <Label fx:id="labelSaudeDetalhe" text="Carregando..."
                       styleClass="dash-gauge-detail"/>
            </VBox>

            <VBox spacing="6" styleClass="dash-gauge-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Valor Total" styleClass="dash-gauge-title"/>
                <Label fx:id="gaugeValorTotal" text="€ 0" styleClass="dash-gauge-value dash-gauge-blue"/>
                <Label fx:id="labelValorDetalhe" text="Carregando..." styleClass="dash-gauge-detail"/>
            </VBox>

            <VBox spacing="6" styleClass="dash-gauge-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Em Manutenção" styleClass="dash-gauge-title"/>
                <Label fx:id="lblEmManutencao" text="0" styleClass="dash-gauge-value dash-gauge-orange"/>
                <Label fx:id="labelManutencaoDetalhe" text="Carregando..." styleClass="dash-gauge-detail"/>
            </VBox>

            <VBox spacing="6" styleClass="dash-gauge-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Críticos" styleClass="dash-gauge-title"/>
                <Label fx:id="gaugeCriticos" text="0" styleClass="dash-gauge-value dash-gauge-red"/>
                <Label fx:id="labelCriticosDetalhe" text="Carregando..." styleClass="dash-gauge-detail"/>
            </VBox>

            <VBox spacing="6" styleClass="dash-gauge-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label text="Previsão Subst. 12m" styleClass="dash-gauge-title"/>
                <Label fx:id="gaugePrevisaoSubstituicao" text="€ 0"
                       styleClass="dash-gauge-value dash-gauge-orange"/>
                <Label fx:id="labelPrevisaoDetalhe" text="Carregando..." styleClass="dash-gauge-detail"/>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 1: GRÁFICOS ==================== -->
        <HBox spacing="12">
            <VBox spacing="8" styleClass="dash-chart-card" HBox.hgrow="ALWAYS" minWidth="300">
                <Label text="Distribuição por Status" styleClass="dash-chart-title"/>
                <PieChart fx:id="pieChartStatus" prefHeight="280"
                          legendVisible="true" labelsVisible="true"
                          styleClass="dash-chart dash-chart-pie"/>
            </VBox>

            <VBox spacing="8" styleClass="dash-chart-card" HBox.hgrow="ALWAYS" minWidth="380">
                <Label text="Equipamentos por Departamento" styleClass="dash-chart-title"/>
                <BarChart fx:id="barChartDepartamento" prefHeight="280"
                          animated="true" barGap="5.0" categoryGap="30.0"
                          styleClass="dash-chart dash-chart-bar">
                    <xAxis><CategoryAxis label="Departamento"/></xAxis>
                    <yAxis><NumberAxis label="Quantidade"/></yAxis>
                </BarChart>
            </VBox>

            <VBox spacing="8" styleClass="dash-chart-card" HBox.hgrow="ALWAYS" minWidth="300">
                <Label text="Por Condição" styleClass="dash-chart-title"/>
                <BarChart fx:id="graficoCondicao" prefHeight="280"
                          animated="true" legendVisible="false"
                          barGap="8.0" categoryGap="40.0"
                          styleClass="dash-chart dash-chart-bar">
                    <xAxis><CategoryAxis fx:id="eixoXCategoria" label="Condição"/></xAxis>
                    <yAxis><NumberAxis fx:id="eixoYQuantidade" label="Quantidade"/></yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 2: GRÁFICOS ==================== -->
        <HBox spacing="12">
            <VBox spacing="8" styleClass="dash-chart-card" HBox.hgrow="ALWAYS" minWidth="400">
                <Label text="Projeção de Substituição (5 anos)" styleClass="dash-chart-title"/>
                <LineChart fx:id="lineChartProjecao" prefHeight="280"
                           animated="true" createSymbols="true"
                           styleClass="dash-chart dash-chart-line">
                    <xAxis><CategoryAxis label="Ano"/></xAxis>
                    <yAxis><NumberAxis label="€ (milhares)"/></yAxis>
                </LineChart>
            </VBox>

            <VBox spacing="8" styleClass="dash-chart-card" HBox.hgrow="ALWAYS" minWidth="400">
                <Label text="Desbalanceamento por Funcionário (Top 10)"
                       styleClass="dash-chart-title"/>
                <BarChart fx:id="barChartBalanceamento" prefHeight="280"
                          animated="true" barGap="3.0" categoryGap="20.0"
                          styleClass="dash-chart dash-chart-bar">
                    <xAxis><CategoryAxis label="Funcionário"/></xAxis>
                    <yAxis><NumberAxis label="Equipamentos"/></yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 3: TABELAS ==================== -->
        <HBox spacing="12">
            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="500">
                <Label text="📋 Itens do Inventário" styleClass="dash-chart-title"/>
                <TableView fx:id="tblInventario" prefHeight="260" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <placeholder>
                        <Label text="Sem itens no inventário." styleClass="dash-empty"/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colInvSKU"           text="SKU"         prefWidth="90"/>
                        <TableColumn fx:id="colInvTipo"          text="Tipo"        prefWidth="90"/>
                        <TableColumn fx:id="colInvMarca"         text="Marca/Modelo" prefWidth="160"/>
                        <TableColumn fx:id="colInvNumSerie"      text="Nº Série"    prefWidth="110"/>
                        <TableColumn fx:id="colInvLocalizacao"   text="Localização" prefWidth="110"/>
                        <TableColumn fx:id="colInvStatus"        text="Status"      prefWidth="80"/>
                        <TableColumn fx:id="colInvCondicao"      text="Condição"    prefWidth="80"/>
                        <TableColumn fx:id="colInvDataAquisicao" text="Aquisição"   prefWidth="100"/>
                        <TableColumn fx:id="colInvAcoes"         text="Ações"       prefWidth="160"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="dash-table-footer">
                    <Label text="Total:" styleClass="dash-total-label"/>
                    <Label fx:id="lblTotalItens" text="0" styleClass="dash-total-value"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btn_detalhesItem" text="Detalhes"
                            styleClass="clay-button clay-button-soft"/>
                    <Button fx:id="btn_relatorioDefeitos" text="Relatório Defeitos"
                            styleClass="clay-button clay-button-danger"/>
                    <Button fx:id="btn_gestaoToners" text="Gestão de Toners"
                            styleClass="clay-button clay-button-primary"/>
                </HBox>
            </VBox>

            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="300">
                <Label text="📍 Distribuição por Localização" styleClass="dash-chart-title"/>
                <TableView fx:id="tblLocalizacao" prefHeight="260" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <columns>
                        <TableColumn fx:id="colLocNome"       text="Localização" prefWidth="180"/>
                        <TableColumn fx:id="colLocQuantidade" text="Qtd"         prefWidth="80"/>
                        <TableColumn fx:id="colLocValor"      text="Valor"       prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 4: TABELAS ==================== -->
        <HBox spacing="12">
            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="500">
                <Label text="⚠ Top 10 — Equipamentos Críticos" styleClass="dash-chart-title"/>
                <TableView fx:id="tabelaCriticos" prefHeight="220" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <columns>
                        <TableColumn fx:id="colCriticoSKU"          text="SKU"          prefWidth="90"/>
                        <TableColumn fx:id="colCriticoNome"         text="Nome"         prefWidth="180"/>
                        <TableColumn fx:id="colCriticoIdade"        text="Idade"        prefWidth="70"/>
                        <TableColumn fx:id="colCriticoStatus"       text="Status"       prefWidth="80"/>
                        <TableColumn fx:id="colCriticoRecomendacao" text="Recomendação" prefWidth="270"/>
                        <TableColumn fx:id="colCriticoAcoes"        text="Ações"        prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="500">
                <Label text="📋 Recomendações de Ação" styleClass="dash-chart-title"/>
                <TableView fx:id="tabelaRecomendacoes" prefHeight="220" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <columns>
                        <TableColumn fx:id="colRecPrioridade" text="!"      prefWidth="35"/>
                        <TableColumn fx:id="colRecAcao"       text="Ação"   prefWidth="110"/>
                        <TableColumn fx:id="colRecItem"       text="Item"   prefWidth="200"/>
                        <TableColumn fx:id="colRecImpacto"    text="Impacto" prefWidth="150"/>
                        <TableColumn fx:id="colRecPrazo"      text="Prazo"  prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 5: TABELAS ==================== -->
        <HBox spacing="12">
            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="500">
                <Label text="🔍 Melhor Custo-Benefício" styleClass="dash-chart-title"/>
                <TableView fx:id="tabelaCustoBeneficio" prefHeight="200" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <columns>
                        <TableColumn fx:id="colCBSKU"         text="SKU"         prefWidth="90"/>
                        <TableColumn fx:id="colCBNome"        text="Modelo"      prefWidth="160"/>
                        <TableColumn fx:id="colCBProcessador" text="Processador" prefWidth="140"/>
                        <TableColumn fx:id="colCBRAM"         text="RAM"         prefWidth="60"/>
                        <TableColumn fx:id="colCBPreco"       text="Preço"       prefWidth="80"/>
                        <TableColumn fx:id="colCBCustoAno"    text="Custo/Ano"   prefWidth="90"/>
                        <TableColumn fx:id="colCBPontuacao"   text="Score"       prefWidth="70"/>
                    </columns>
                </TableView>
            </VBox>

            <VBox spacing="8" styleClass="dash-table-card" HBox.hgrow="ALWAYS" minWidth="500">
                <Label text="📦 Estoque Inteligente — Alertas" styleClass="dash-chart-title"/>
                <TableView fx:id="tabelaEstoqueAlertas" prefHeight="200" VBox.vgrow="ALWAYS"
                           styleClass="dash-table">
                    <columns>
                        <TableColumn fx:id="colEstSKU"      text="SKU"      prefWidth="90"/>
                        <TableColumn fx:id="colEstNome"     text="Produto"  prefWidth="180"/>
                        <TableColumn fx:id="colEstAtual"    text="Estoque"  prefWidth="70"/>
                        <TableColumn fx:id="colEstMinimo"   text="Mínimo"   prefWidth="70"/>
                        <TableColumn fx:id="colEstExcesso"  text="Excesso"  prefWidth="70"/>
                        <TableColumn fx:id="colEstSugestao" text="Sugestão" prefWidth="180"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <!-- ==================== LINHA 6: TABELA FULL ==================== -->
        <VBox spacing="8" styleClass="dash-table-card">
            <Label text="🕐 Itens Parados (sem movimentação &gt; 90 dias)"
                   styleClass="dash-chart-title"/>
            <TableView fx:id="tabelaItensParados" prefHeight="200" VBox.vgrow="ALWAYS"
                       styleClass="dash-table">
                <columns>
                    <TableColumn fx:id="colParadoSKU"   text="SKU"              prefWidth="100"/>
                    <TableColumn fx:id="colParadoNome"  text="Item"             prefWidth="250"/>
                    <TableColumn fx:id="colParadoDias"  text="Dias Parado"      prefWidth="110"/>
                    <TableColumn fx:id="colParadoValor" text="Valor Imobilizado" prefWidth="150"/>
                    <TableColumn fx:id="colParadoAcao"  text="Ação Sugerida"    prefWidth="250"/>
                </columns>
            </TableView>
        </VBox>

        <!-- ==================== RODAPÉ ==================== -->
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="dash-status-bar">
            <padding><Insets top="8" right="15" bottom="8" left="15"/></padding>
            <Label fx:id="labelUltimaAtualizacao" text="Última análise: --"
                   styleClass="dash-status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="statusLabel" text="Sistema de Análise Ativo"
                   styleClass="dash-status-text"/>
            <ProgressIndicator fx:id="progressIndicator" progress="0.0"
                               visible="false"
                               prefWidth="18" prefHeight="18"
                               styleClass="dash-progress"/>
        </HBox>

    </VBox>
</ScrollPane>
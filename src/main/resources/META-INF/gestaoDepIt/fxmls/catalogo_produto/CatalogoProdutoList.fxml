<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Catalogo.fxml v2.0
    Ecrã de catálogo de produtos.
    Estilização em catalogo.css (específica) + design system global.
-->
<AnchorPane styleClass="app-root, catalogo-root"
            xmlns="http://javafx.com/javafx/21.0"
            xmlns:fx="http://javafx.com/fxml/1">

    <VBox styleClass="catalogo-container"
          spacing="16"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ==================================================== -->
        <!-- HEADER                                                -->
        <!-- ==================================================== -->

        <HBox styleClass="catalogo-header"
              alignment="CENTER_LEFT"
              spacing="16">

            <Label text="Catálogo de Produtos"
                   styleClass="catalogo-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btn_novo"
                    text="+ Novo Produto"
                    styleClass="ds-button, ds-button--primary"/>

        </HBox>

        <!-- ==================================================== -->
        <!-- FILTROS                                               -->
        <!-- ==================================================== -->

        <VBox styleClass="ds-card, catalogo-card"
              spacing="12">

            <Label text="Filtros"
                   styleClass="catalogo-card-header"/>

            <GridPane styleClass="catalogo-filters-grid"
                      hgap="16" vgap="12">

                <columnConstraints>
                    <ColumnConstraints minWidth="90"  prefWidth="100"/>
                    <ColumnConstraints minWidth="180" prefWidth="220" hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="90"  prefWidth="100"/>
                    <ColumnConstraints minWidth="180" prefWidth="220" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Linha 1: Tipo | Categoria -->
                <Label text="Tipo:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"
                       GridPane.valignment="CENTER"/>

                <ComboBox fx:id="filtroTipo"
                          promptText="Todos os tipos"
                          maxWidth="Infinity"
                          styleClass="ds-input"
                          GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Categoria:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="0" GridPane.columnIndex="2"
                       GridPane.valignment="CENTER"/>

                <TextField fx:id="filtroCategoria"
                           promptText="Categoria..."
                           maxWidth="Infinity"
                           styleClass="ds-input"
                           GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <!-- Linha 2: Marca | Modelo -->
                <Label text="Marca:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"
                       GridPane.valignment="CENTER"/>

                <TextField fx:id="filtroMarca"
                           promptText="Marca..."
                           maxWidth="Infinity"
                           styleClass="ds-input"
                           GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Modelo:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="1" GridPane.columnIndex="2"
                       GridPane.valignment="CENTER"/>

                <TextField fx:id="filtroModelo"
                           promptText="Modelo..."
                           maxWidth="Infinity"
                           styleClass="ds-input"
                           GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <!-- Linha 3: Estoque | Status -->
                <Label text="Estoque:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"
                       GridPane.valignment="CENTER"/>

                <ComboBox fx:id="filtroEstoque"
                          promptText="Todos"
                          maxWidth="Infinity"
                          styleClass="ds-input"
                          GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Status:"
                       styleClass="ds-field-label"
                       GridPane.rowIndex="2" GridPane.columnIndex="2"
                       GridPane.valignment="CENTER"/>

                <ComboBox fx:id="filtroStatus"
                          promptText="Todos os status"
                          maxWidth="Infinity"
                          styleClass="ds-input"
                          GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <!-- Linha 4: botões -->
                <HBox spacing="10"
                      alignment="CENTER_RIGHT"
                      styleClass="catalogo-filters-actions"
                      GridPane.rowIndex="3" GridPane.columnIndex="2"
                      GridPane.columnSpan="2">

                    <Button fx:id="btn_limparFiltros"
                            text="Limpar Filtros"
                            styleClass="ds-button, ds-button--ghost"/>

                    <Button fx:id="btn_aplicarFiltros"
                            text="Aplicar Filtros"
                            styleClass="ds-button, ds-button--primary"/>

                </HBox>

            </GridPane>
        </VBox>

        <!-- ==================================================== -->
        <!-- ESTATÍSTICAS                                          -->
        <!-- ==================================================== -->

        <HBox styleClass="catalogo-stats-row"
              spacing="12"
              alignment="CENTER_LEFT">

            <Label fx:id="estatisticasLabel"
                   text="Carregando estatísticas..."
                   styleClass="catalogo-statistics"/>

            <Label fx:id="filtrosAtivosLabel"
                   text=""
                   styleClass="catalogo-active-filters"
                   managed="false"
                   visible="false"/>

        </HBox>

        <!-- ==================================================== -->
        <!-- TABELA                                                -->
        <!-- ==================================================== -->

        <VBox VBox.vgrow="ALWAYS" spacing="12">

            <TableView fx:id="produtosTable"
                       VBox.vgrow="ALWAYS"
                       styleClass="ds-table, catalogo-table">

                <placeholder>
                    <Label text="Nenhum produto encontrado com os filtros atuais."
                           styleClass="catalogo-empty"
                           wrapText="true"/>
                </placeholder>

                <columns>
                    <TableColumn fx:id="colSku"           text="SKU"           prefWidth="120"/>
                    <TableColumn fx:id="colTipo"          text="Tipo"          prefWidth="100"/>
                    <TableColumn fx:id="colCategoria"     text="Categoria"     prefWidth="120"/>
                    <TableColumn fx:id="colMarca"         text="Marca"         prefWidth="110"/>
                    <TableColumn fx:id="colModelo"        text="Modelo"        prefWidth="130"/>
                    <TableColumn fx:id="colCor"           text="Cor"           prefWidth="70"/>
                    <TableColumn fx:id="colPrecoUnitario" text="Preço €"       prefWidth="90"/>
                    <TableColumn fx:id="colIva"           text="IVA %"         prefWidth="70"/>
                    <TableColumn fx:id="colPrecoTotal"    text="Preço Total €" prefWidth="110"/>
                    <TableColumn fx:id="colEstoque"       text="Estoque"       prefWidth="80"/>
                    <TableColumn fx:id="colStatus"        text="Status"        prefWidth="90"/>
                    <TableColumn fx:id="colAcoes"         text="Ações"         prefWidth="140"/>
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
            </TableView>

            <!-- Paginação -->
            <HBox styleClass="catalogo-pagination-bar"
                  spacing="8"
                  alignment="CENTER_LEFT">

                <Button fx:id="btn_primeira" text="|«"
                        styleClass="ds-button, ds-button--secondary, ds-button--compact, catalogo-page-btn"/>
                <Button fx:id="btn_anterior" text="‹"
                        styleClass="ds-button, ds-button--secondary, ds-button--compact, catalogo-page-btn"/>

                <Label fx:id="labelPagina"
                       text="Página 1 de 1"
                       styleClass="catalogo-pagination-label"/>

                <Button fx:id="btn_proxima" text="›"
                        styleClass="ds-button, ds-button--secondary, ds-button--compact, catalogo-page-btn"/>
                <Button fx:id="btn_ultima" text="»|"
                        styleClass="ds-button, ds-button--secondary, ds-button--compact, catalogo-page-btn"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Itens por página:"
                       styleClass="catalogo-pagination-label"/>

                <ComboBox fx:id="comboItensPorPagina"
                          prefWidth="90"
                          styleClass="ds-input"/>

            </HBox>

        </VBox>

        <!-- ==================================================== -->
        <!-- STATUS BAR                                            -->
        <!-- ==================================================== -->

        <HBox styleClass="catalogo-status-bar"
              spacing="10"
              alignment="CENTER_LEFT">

            <Label fx:id="statusLabel"
                   text="Pronto"
                   styleClass="catalogo-status-text"/>

            <Region HBox.hgrow="ALWAYS"/>

            <ProgressIndicator fx:id="progressIndicator"
                               progress="0.0"
                               visible="false"
                               prefWidth="20" prefHeight="20"
                               styleClass="catalogo-progress"/>

        </HBox>

    </VBox>
</AnchorPane>
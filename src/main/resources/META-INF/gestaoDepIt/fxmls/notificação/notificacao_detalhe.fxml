<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" prefHeight="400.0" prefWidth="600.0" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ossobo.gestaoDepIt.MainConfig.systemsAletry.alertys.inventarios.config.NotificacaoDetalhe">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="title-label" text="Detalhes da Notificação:" />

    <ScrollPane fitToWidth="true" styleClass="message-scroll-pane" VBox.vgrow="ALWAYS">
        <content>
            <Label fx:id="labelConteudoNotificacao" text="Aqui aparecerão os detalhes completos da notificação." wrapText="true" />
        </content>
    </ScrollPane>
   <AnchorPane maxHeight="40.0" minHeight="40.0" prefHeight="50.0" prefWidth="560.0">
      <children>
      
          <Button fx:id="Btn_close" layoutX="14.0" layoutY="7.0" onAction="#close" text="Fechar" AnchorPane.topAnchor="10.0" />
         <Button fx:id="Btn_resolvido" layoutX="135.0" layoutY="7.0" mnemonicParsing="false" text="Resolvido" AnchorPane.topAnchor="10.0" />
      </children>
   </AnchorPane>
</VBox>

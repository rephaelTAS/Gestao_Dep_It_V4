<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<!--
    🖼️ SplashScreen.fxml
    =====================
    Tela de carregamento da aplicação.
    NÃO é gerenciada pelo WinterFX (por isso tem fx:controller).
    Controller: com.ossobo.gestaoDepIt.ui.splash.SplashScreenController
    Versão: 3.1
-->

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ossobo.gestaoDepIt.ui.splash.SplashScreenController"
            prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #1a252f); -fx-border-color: #34495e; -fx-border-width: 2px;">

    <effect>
        <DropShadow offsetX="0" offsetY="5" radius="10" color="rgba(0,0,0,0.3)" />
    </effect>

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <!-- Ícone/Título Principal -->
        <Label text="🏔️ Gestão de TI"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ecf0f1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 0);"/>

        <!-- Subtítulo -->
        <Label text="Sistema de Gestão de Departamento de TI"
               style="-fx-font-size: 14px; -fx-text-fill: #95a5a6; -fx-font-weight: normal;"/>

        <!-- Barra de Progresso -->
        <ProgressBar fx:id="progressBar"
                     prefWidth="400"
                     progress="0.0"
                     style="-fx-accent: #27ae60; -fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 10px;"/>

        <!-- Status Label -->
        <Label fx:id="statusLabel"
               text="Inicializando componentes..."
               wrapText="true"
               alignment="CENTER"
               style="-fx-font-size: 13px; -fx-text-fill: #bdc3c7;"/>

        <VBox.margin>
            <Insets top="10" />
        </VBox.margin>

        <!-- Versão e Framework -->
        <Label text="v3.1 | WinterFX 13.1.5 | SQLite + MySQL"
               style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>

        <!-- Modo DEV (opcional - pode ser controlado via código) -->
        <Label fx:id="devModeLabel"
               text="🔧 MODO DESENVOLVIMENTO"
               style="-fx-font-size: 11px; -fx-text-fill: #f1c40f; -fx-background-color: rgba(0,0,0,0.3); -fx-padding: 3px 12px; -fx-background-radius: 15px;"
               visible="false" managed="false"/>
    </VBox>

</AnchorPane>
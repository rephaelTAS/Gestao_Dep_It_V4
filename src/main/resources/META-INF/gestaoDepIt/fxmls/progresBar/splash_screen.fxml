<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>

<!--
    🖼️ SplashScreen.fxml
    =====================
    Tela de carregamento da aplicação.
    NÃO é gerenciada pelo WinterFX (por isso tem fx:controller).
    Controller: com.ossobo.gestaoDepIt.ui.splash.SplashScreenController
    Versão: 3.2 (paleta oficial + sem estilos inline)
-->

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefHeight="400.0" prefWidth="600.0"
            styleClass="splash-root">

    <effect>
        <DropShadow offsetX="0" offsetY="5" radius="12" color="rgba(0,0,0,0.35)" />
    </effect>

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <!-- Ícone/Título Principal -->
        <Label text="🏔️ Gestão de TI"
               styleClass="splash-title"/>

        <!-- Subtítulo -->
        <Label text="Sistema de Gestão de Departamento de TI"
               styleClass="splash-subtitle"/>

        <!-- Barra de Progresso -->
        <ProgressBar fx:id="progressBar"
                     progress="0.0"
                     styleClass="splash-progress"/>

        <!-- Status Label -->
        <Label fx:id="statusLabel"
               text="Inicializando componentes..."
               wrapText="true"
               alignment="CENTER"
               styleClass="splash-status"/>

        <!-- Versão e Framework -->
        <Label text="v3.1 | WinterFX 13.1.5 | SQLite + MySQL"
               styleClass="splash-version"/>

        <!-- Modo DEV (opcional - pode ser controlado via código) -->
        <Label fx:id="devModeLabel"
               text="🔧 MODO DESENVOLVIMENTO"
               styleClass="splash-dev-badge"
               visible="false" managed="false"/>
    </VBox>

</AnchorPane>
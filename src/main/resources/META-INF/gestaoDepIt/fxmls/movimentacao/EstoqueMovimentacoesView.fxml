<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ossobo.gestaoDepIt.controllers.gestao.estoque.movimentacoes.EstoqueMovimentacoesController">

    <VBox spacing="15" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- Cabeçalho com Botão de Nova Movimentação -->
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Movimentações de Estoque" />
            <Region HBox.hgrow="ALWAYS" />

            <!-- 🔥 Botão para adicionar movimentação -->
            <Button fx:id="btn_addmovimneta" onAction="#abrirFormularioMovimentacao" style="-fx-background-color: #20c997; -fx-text-fill: white; -fx-font-weight: bold;" text="➕ Nova Movimentação" HBox.margin="$x10,0,0,0" />

            <Button onAction="#gerarRelatorio" style="-fx-background-color: #17a2b8; -fx-text-fill: white;" text="📊 Relatório" />
            <Button onAction="#exportarDados" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="📤 Exportar" />
        </HBox>

        <!-- Filtros Avançados -->
        <VBox fx:id="filtrosContainer" spacing="10" style="-fx-padding: 15; -fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-radius: 5;">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #495057;" text="Filtros de Pesquisa" />

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="200" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="150" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="100" prefWidth="200" />
                </columnConstraints>

                <!-- Linha 1 -->
                <Label text="Período:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <HBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <DatePicker fx:id="dataInicioPicker" promptText="Data Início" />
                    <Label text="até" />
                    <DatePicker fx:id="dataFimPicker" promptText="Data Fim" />
                </HBox>

                <Label text="Tipo Movimentação:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <ComboBox fx:id="filtroTipoMovimentacao" promptText="Todos os tipos" GridPane.columnIndex="3" GridPane.rowIndex="0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="ENTRADA" />
                            <String fx:value="SAÍDA" />
                            <String fx:value="TRANSFERÊNCIA" />
                            <String fx:value="AJUSTE" />
                        </FXCollections>
                    </items>
                </ComboBox>

                <!-- Linha 2 -->
                <Label text="Produto:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <ComboBox fx:id="filtroProdutoCombo" promptText="Selecione o produto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Lote:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <TextField fx:id="filtroLoteField" promptText="Número do lote" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <!-- Botões de Filtro -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button onAction="#limparFiltros" text="Limpar Filtros" />
                <Button onAction="#aplicarFiltros" style="-fx-background-color: #007bff; -fx-text-fill: white;" text="Aplicar Filtros" />
            </HBox>
        </VBox>

        <!-- Gráfico de Movimentações -->
        <VBox fx:id="graficoContainer" managed="false" spacing="10" visible="false">
            <Label style="-fx-font-weight: bold;" text="Resumo de Movimentações por Tipo" />
            <PieChart fx:id="movimentacoesChart" prefHeight="200" />
        </VBox>

        <!-- Tabela de Movimentações -->
        <TableView fx:id="movimentacoesTable" VBox.vgrow="ALWAYS">
            <columns>
                <!-- Data -->
                <TableColumn prefWidth="100" text="Data">
                    <cellValueFactory>
                        <PropertyValueFactory property="dataMovimentacao" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Produto -->
                <TableColumn prefWidth="150" text="Produto">
                    <cellValueFactory>
                        <PropertyValueFactory property="nomeProduto" />
                    </cellValueFactory>
                </TableColumn>

                <!-- SKU -->
                <TableColumn prefWidth="100" text="SKU">
                    <cellValueFactory>
                        <PropertyValueFactory property="skuProduto" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Tipo Movimentação -->
                <TableColumn prefWidth="90" text="Tipo">
                    <cellValueFactory>
                        <PropertyValueFactory property="tipoMovimentacao" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Quantidade -->
                <TableColumn prefWidth="80" text="Quantidade">
                    <cellValueFactory>
                        <PropertyValueFactory property="quantidade" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Lote -->
                <TableColumn prefWidth="100" text="Lote">
                    <cellValueFactory>
                        <PropertyValueFactory property="lote" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Validade -->
                <TableColumn prefWidth="100" text="Validade">
                    <cellValueFactory>
                        <PropertyValueFactory property="dataValidade" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Localização -->
                <TableColumn prefWidth="120" text="Localização">
                    <cellValueFactory>
                        <PropertyValueFactory property="localizacao" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Responsável -->
                <TableColumn prefWidth="120" text="Responsável">
                    <cellValueFactory>
                        <PropertyValueFactory property="nomeUsuario" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Motivo -->
                <TableColumn prefWidth="150" text="Motivo">
                    <cellValueFactory>
                        <PropertyValueFactory property="motivo" />
                    </cellValueFactory>
                </TableColumn>

                <!-- Coluna de Ações -->
                <TableColumn prefWidth="100" text="Ações">
                    <cellValueFactory>
                        <PropertyValueFactory property="acoes" />
                    </cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <!-- Rodapé com Estatísticas -->
        <HBox fx:id="estatisticasContainer" alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 12; -fx-text-fill: #666;" text="Total Entradas" />
                <Label fx:id="totalEntradasLabel" style="-fx-font-weight: bold; -fx-text-fill: #28a745;" text="0" />
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 12; -fx-text-fill: #666;" text="Total Saídas" />
                <Label fx:id="totalSaidasLabel" style="-fx-font-weight: bold; -fx-text-fill: #dc3545;" text="0" />
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 12; -fx-text-fill: #666;" text="Saldo" />
                <Label fx:id="saldoLabel" style="-fx-font-weight: bold; -fx-text-fill: #007bff;" text="0" />
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 12; -fx-text-fill: #666;" text="Registros" />
                <Label fx:id="totalRegistrosLabel" style="-fx-font-weight: bold;" text="0" />
            </VBox>

            <!-- 🔥 ADICIONADO: Período -->
            <VBox alignment="CENTER" spacing="5">
                <Label style="-fx-font-size: 12; -fx-text-fill: #666;" text="Período" />
                <Label fx:id="periodoLabel" style="-fx-font-weight: bold;" text="Últimos 30 dias" />
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>

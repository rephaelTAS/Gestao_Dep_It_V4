<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!-- ===== ROOT COM SCROLL VERTICAL ===== -->

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="780.0" prefWidth="1001.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ossobo.gestaoDepIt.controllers.gestao.estoque.movimentacoes.detalhes.EstoqueMovimentacaoDetalhesController">

    <!-- ===== CONTAINER PRINCIPAL OTIMIZADO ===== -->
    <AnchorPane maxHeight="750" maxWidth="1014" minHeight="650" minWidth="1000" style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">
        <!-- NOTA: minHeight/maxHeight reduzidos de 900 para 750 -->

        <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
        </padding>

        <!-- ===== CABEÇALHO MAIS COMPACTO ===== -->
        <VBox AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <HBox alignment="CENTER_LEFT" maxHeight="70" spacing="12.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0.5, 0, 2);">
                <padding>
                    <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                </padding>

                <!-- Ícone e Título -->
                <StackPane>
                    <Circle fill="#3498db" radius="18.0" />
                    <Label style="-fx-font-size: 14px;" text="📦" />
                </StackPane>

                <VBox spacing="2.0">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #2c3e50;" text="Detalhes da Movimentação" wrapText="true" />
                    <Label fx:id="subtitleLabel" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;" text="Visualização completa" wrapText="true" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Botões de Ação Compactos -->
                <HBox alignment="CENTER_RIGHT" spacing="6.0">
                    <Button fx:id="btnImprimir" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-min-width: 36; -fx-min-height: 36;" text="🖨️">
                        <tooltip>
                            <Tooltip text="Imprimir detalhes" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnExportar" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-min-width: 36; -fx-min-height: 36;" text="📤">
                        <tooltip>
                            <Tooltip text="Exportar dados" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnVoltar" onAction="#handleVoltar" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-border-color: #e74c3c; -fx-border-radius: 20; -fx-min-width: 36; -fx-min-height: 36;" text="✕">
                        <tooltip>
                            <Tooltip text="Fechar (ESC)" />
                        </tooltip>
                    </Button>
                </HBox>
            </HBox>
        </VBox>

        <!-- ===== CONTEÚDO PRINCIPAL REORGANIZADO ===== -->
        <VBox spacing="12.0" AnchorPane.bottomAnchor="35.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="75.0">

            <!-- ===== CARDS DE RESUMO EM LINHA ÚNICA ===== -->
            <HBox alignment="TOP_CENTER" spacing="12.0">

                <!-- Card Tipo Movimentação -->
                <VBox maxWidth="220" minWidth="180" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="TIPO" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <StackPane>
                            <Circle fx:id="tipoCircle" radius="10.0" />
                            <Label fx:id="tipoIcon" style="-fx-font-size: 11px;" />
                        </StackPane>
                        <Label fx:id="tipoLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" wrapText="true" />
                    </HBox>
                </VBox>

                <!-- Card Quantidade -->
                <VBox maxWidth="220" minWidth="180" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="QUANTIDADE" />
                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                        <Label fx:id="quantidadeLabel" style="-fx-font-size: 20px; -fx-font-weight: 900; -fx-text-fill: #2c3e50;" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-padding: 4 0 0 0;" text="unid" />
                    </HBox>
                </VBox>

                <!-- Card Status Temporal -->
                <VBox maxWidth="250" minWidth="200" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="STATUS" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <StackPane>
                            <Circle fx:id="statusCircle" radius="8.0" />
                        </StackPane>
                        <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-font-weight: bold;" wrapText="true" />
                    </HBox>
                    <Label fx:id="statusDetailLabel" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" wrapText="true" />
                </VBox>

                <!-- Card Rastreabilidade -->
                <VBox maxWidth="300" minWidth="240" spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                    <padding><Insets bottom="10.0" left="12.0" right="12.0" top="10.0" /></padding>
                    <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;" text="RASTREABILIDADE" />
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" text="ID:" />
                        <Label fx:id="idLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" text="Criado:" />
                        <Label fx:id="createdAtLabel" style="-fx-font-size: 10px; -fx-font-weight: bold;" />
                    </HBox>
                    <Label fx:id="rastreabilidadeLabel" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-wrap-text: true;" />
                </VBox>
            </HBox>

            <!-- ===== LAYOUT PRINCIPAL - LARGURA AUMENTADA ===== -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">

                <!-- ===== COLUNA ESQUERDA MAIS LARGA ===== -->
                <VBox minWidth="550" spacing="10.0" HBox.hgrow="ALWAYS">

                    <!-- Card Informações do Produto -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#3498db" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="INFORMAÇÕES DO PRODUTO" />
                        </HBox>

                        <GridPane hgap="10.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="100" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Produto:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="produtoLabel" style="-fx-font-size: 12px;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="codigoProdutoLabel" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px; -fx-text-fill: #2c3e50;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Categoria:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="categoriaLabel" style="-fx-font-size: 12px;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Card Detalhes da Movimentação -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#e74c3c" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="DETALHES DA MOVIMENTAÇÃO" />
                        </HBox>

                        <GridPane hgap="10.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" prefWidth="100" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label fx:id="dataMovimentacaoLabel" style="-fx-font-weight: bold; -fx-font-size: 12px;" />
                                <Label fx:id="diasAtrasLabel" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Lote:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <Label fx:id="loteLabel" style="-fx-font-family: 'Consolas', monospace; -fx-font-size: 11px;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Localização:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                <Label fx:id="localizacaoLabel" style="-fx-font-size: 12px;" wrapText="true" />
                                <Button fx:id="btnMapa" style="-fx-background-color: transparent; -fx-padding: 1; -fx-min-width: 28; -fx-min-height: 28;" text="🗺️">
                                    <tooltip>
                                        <Tooltip text="Ver localização" />
                                    </tooltip>
                                </Button>
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Validade:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                <Label fx:id="validadeLabel" style="-fx-font-size: 12px;" wrapText="true" />
                                <Label fx:id="validadeStatusLabel" style="-fx-font-size: 9px; -fx-padding: 1 3 1 3; -fx-background-radius: 6;" />
                            </HBox>

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Fim Licença:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <Label fx:id="fimLicencaLable" style="-fx-font-size: 12px;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                        </GridPane>
                    </VBox>

                    <!-- Card Observações MAIS COMPACTO -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#f39c12" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="OBSERVAÇÕES" />
                        </HBox>

                        <VBox spacing="6.0">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Motivo:" />
                            <TextArea fx:id="motivoTextArea" editable="false" prefHeight="60" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 5; -fx-font-size: 11px;" wrapText="true" />

                            <Label style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 11px;" text="Detalhes:" />
                            <TextArea fx:id="observacoesTextArea" editable="false" prefHeight="80" style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 5; -fx-font-size: 11px;" wrapText="true" />
                        </VBox>
                    </VBox>
                </VBox>

                <!-- ===== COLUNA DIREITA OTIMIZADA ===== -->
                <VBox maxWidth="380" minWidth="300" spacing="10.0">

                    <!-- Card Responsável -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#2ecc71" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="RESPONSÁVEL" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <StackPane>
                                <Circle fill="#ecf0f1" radius="20.0" />
                                <Label fx:id="usuarioInicial" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                            </StackPane>

                            <VBox spacing="2.0">
                                <Label fx:id="usuarioNomeLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" wrapText="true" />
                                <Label fx:id="usuarioDepartamentoLabel" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" wrapText="true" />
                                <Label fx:id="usuarioEmailLabel" style="-fx-font-size: 9px; -fx-text-fill: #3498db;" wrapText="true" />
                            </VBox>
                        </HBox>

                        <Button fx:id="btnContatar" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-font-size: 11px; -fx-pref-height: 30;" text="✉️ Mensagem">
                            <tooltip>
                                <Tooltip text="Enviar mensagem ao responsável" />
                            </tooltip>
                        </Button>
                    </VBox>

                    <!-- Card Timeline MAIS COMPACTO -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#9b59b6" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="LINHA DO TEMPO" />
                        </HBox>

                        <VBox fx:id="timelineContainer" spacing="6.0" VBox.vgrow="ALWAYS">
                            <!-- Timeline items serão adicionados dinamicamente -->
                        </VBox>
                    </VBox>

                    <!-- Card Ações Rápidas -->
                    <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                        <padding><Insets bottom="12.0" left="15.0" right="15.0" top="12.0" /></padding>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <Rectangle arcHeight="3" arcWidth="3" fill="#e74c3c" height="16" width="3" />
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="AÇÕES" />
                        </HBox>

                        <VBox spacing="6.0">
                            <Button fx:id="btnEditar" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-font-size: 11px; -fx-pref-height: 30;" text="✏️ Editar">
                                <tooltip>
                                    <Tooltip text="Editar esta movimentação" />
                                </tooltip>
                            </Button>

                            <Button fx:id="btnDuplicar" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-font-size: 11px; -fx-pref-height: 30;" text="📋 Duplicar">
                                <tooltip>
                                    <Tooltip text="Criar cópia desta movimentação" />
                                </tooltip>
                            </Button>

                            <Button fx:id="btnExcluir" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-font-size: 11px; -fx-pref-height: 30;" text="🗑️ Excluir">
                                <tooltip>
                                    <Tooltip text="Excluir esta movimentação" />
                                </tooltip>
                            </Button>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- ===== RODAPÉ MAIS DISCRETO ===== -->
        <HBox alignment="CENTER" spacing="4.0" AnchorPane.bottomAnchor="4.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 9px;" text="Sistema de Gestão • " />
            <Label fx:id="lastUpdatedLabel" style="-fx-text-fill: #7f8c8d; -fx-font-size: 9px; -fx-font-weight: bold;" text="Atualizado: --" />
        </HBox>
    </AnchorPane>
</ScrollPane>

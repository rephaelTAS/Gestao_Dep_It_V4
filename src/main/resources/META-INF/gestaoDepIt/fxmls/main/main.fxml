<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!--
    Main.fxml v2.0
    Objetivo: shell principal (header, sidebar, content, footer, painel direito).
    Regras visuais: surface #FEFEFE nas bordas, content #E8E5DE;
    separação por elevação (.elevation-1..4) e bordas sutis #AFAAA4.
    Estilização em Main.css.
-->
<BorderPane fx:id="borderpanel" styleClass="app-root"
            stylesheets="@Main.css"
            xmlns="http://javafx.com/javafx/21.0"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- ========== HEADER ========== -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="app-header elevation-1">
            <padding>
                <Insets bottom="8" left="16" right="16" top="8" />
            </padding>

            <Button fx:id="toggleMenuBtn" styleClass="app-header-icon-btn">
                <HBox.margin><Insets right="12" /></HBox.margin>
                <graphic>
                    <ImageView fx:id="menuIcon" fitHeight="20" fitWidth="20"
                               preserveRatio="true" styleClass="app-header-icon" />
                </graphic>
            </Button>

            <Label styleClass="app-header-title" text="Gestão de Equipamentos TI" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_LEFT" spacing="8">
                <ImageView fx:id="iconepage" fitHeight="22" fitWidth="22"
                           preserveRatio="true" styleClass="app-page-icon" />
                <Label fx:id="nomepage" styleClass="app-page-name" text="Dashboard" wrapText="true" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btn_definicoes" text="Definições" styleClass="app-header-text-btn" />

                <Button fx:id="btn_notificacao" styleClass="app-header-icon-btn">
                    <graphic>
                        <ImageView fx:id="imageNotificatio" fitHeight="18" fitWidth="18"
                                   preserveRatio="true" styleClass="app-header-icon" />
                    </graphic>
                </Button>

                <Separator orientation="VERTICAL" prefHeight="30" />

                <HBox alignment="CENTER" spacing="8" styleClass="app-user-card">
                    <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="app-user-info">
                        <HBox alignment="BASELINE_RIGHT" spacing="4">
                            <Label fx:id="timeLabel" styleClass="app-time-display" text="14:30" />
                            <Label fx:id="dateLabel" styleClass="app-date-display" text="15/12/24" />
                        </HBox>
                        <HBox alignment="BASELINE_RIGHT" spacing="4">
                            <Label fx:id="nameUser" styleClass="app-user-name" text="Administrador" wrapText="true" />
                            <Label styleClass="app-user-status-dot" text="●" />
                        </HBox>
                    </VBox>

                    <StackPane styleClass="app-avatar-container">
                        <ImageView fx:id="imageUser" fitHeight="36" fitWidth="36"
                                   preserveRatio="true" styleClass="app-avatar-image" />
                        <Rectangle arcHeight="20" arcWidth="20" height="36" width="36"
                                   styleClass="app-avatar-border" />
                    </StackPane>
                </HBox>
            </HBox>
        </HBox>
    </top>

    <!-- ========== SIDEBAR ========== -->
    <left>
        <VBox fx:id="sidebar" prefWidth="280" styleClass="app-sidebar">

            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="10" styleClass="app-sidebar-header">
                <ImageView fitHeight="32" fitWidth="32" preserveRatio="true" styleClass="app-sidebar-logo" />
                <Label styleClass="app-sidebar-title" text="TechManager Pro" wrapText="true" />
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="app-sidebar-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="menuContainer" spacing="4" styleClass="app-menu-container">

                        <Label styleClass="app-menu-section" text="PRINCIPAL" />

                        <Button fx:id="btn_dashboard" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="dashboardIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Dashboard</text>
                        </Button>

                        <Separator styleClass="app-menu-separator" />

                        <Label styleClass="app-menu-section" text="ESTOQUE" />

                        <Button fx:id="btn_catalogo" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="catalogoIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Catálogo Produtos</text>
                        </Button>

                        <Button fx:id="btn_estoque" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="estoqueIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Movimentações</text>
                        </Button>

                        <Button fx:id="btn_produtoStock" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="produtoStockIcone" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Gestão De Produtos e Inventario</text>
                        </Button>

                        <Separator styleClass="app-menu-separator" />

                        <Label styleClass="app-menu-section" text="EQUIPAMENTOS" />

                        <Button fx:id="btn_inventario" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="inventarioIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Inventário</text>
                        </Button>

                        <Button fx:id="btn_toners" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="tonersIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Gestão de Toners</text>
                        </Button>

                        <Separator styleClass="app-menu-separator" />

                        <Label styleClass="app-menu-section" text="PESSOAL" />

                        <Button fx:id="btn_funcionarios" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="funcionariosIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Funcionários</text>
                        </Button>

                        <Button fx:id="btn_usuarios" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="addItemIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Usuarios</text>
                        </Button>

                        <Separator styleClass="app-menu-separator" />

                        <Label styleClass="app-menu-section" text="RELATÓRIOS" />

                        <Button fx:id="btn_relatorio" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="reportIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Relatórios</text>
                        </Button>

                        <Button fx:id="btn_historico" maxWidth="Infinity" mnemonicParsing="false" styleClass="app-menu-item">
                            <graphic><ImageView fx:id="historicoIcon" fitHeight="20" fitWidth="20" preserveRatio="true" styleClass="app-menu-icon" /></graphic>
                            <text>Histórico</text>
                        </Button>
                    </VBox>
                </content>
            </ScrollPane>

            <VBox styleClass="app-sidebar-status" VBox.vgrow="NEVER">
                <Label styleClass="app-status-title" text="STATUS DO SISTEMA" />
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <StackPane styleClass="app-status-indicator">
                        <Rectangle arcHeight="4" arcWidth="4" height="8" width="8" styleClass="app-status-dot" />
                    </StackPane>
                    <Label styleClass="app-status-value" text="Operacional" />
                </HBox>
                <Label styleClass="app-version-text" text="Versão 2.0.0" />
            </VBox>
        </VBox>
    </left>

    <!-- ========== CONTENT ========== -->
    <center>
        <StackPane fx:id="multiploPanel" styleClass="app-content-area">
            <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
        </StackPane>
    </center>

    <!-- ========== FOOTER ========== -->
    <bottom>
        <HBox alignment="CENTER" prefHeight="48" styleClass="app-footer">
            <Label fx:id="lblFooter" styleClass="app-footer-text"
                   text="© 2024 Gestão de Equipamentos de TI - Todos os direitos reservados"
                   textAlignment="CENTER" wrapText="true" />
        </HBox>
    </bottom>

    <!-- ========== PAINEL DIREITO ========== -->
    <right>
        <StackPane fx:id="stack_sistema" prefWidth="380"
                   styleClass="app-right-panel elevation-2">
            <BorderPane.margin>
                <Insets bottom="12.0" left="0.0" right="12.0" top="12.0" />
            </BorderPane.margin>
            <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
        </StackPane>
    </right>
</BorderPane>